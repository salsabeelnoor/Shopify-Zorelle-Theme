{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  /* Zorelle: product card title (500 weight face loaded in theme-styles-variables). */
  product-card a.user-select-text .text-block > * {
    font-weight: 500;
    letter-spacing: 1.3px;
  }

  /* Zorelle: product card price (size from the price block setting: 14px).
     .custom-typography is repeated to outrank the block's own typography variables. */
  /* Card price: 14px, weight 500, 1px letter spacing, whichever type preset the price
     block uses (h6 and the other presets style the inner elements directly). */
  product-card product-price.text-block,
  product-card product-price.text-block > *,
  product-card product-price.text-block :is([ref='priceContainer'], .price, .price-item__group, bdi) {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
  }

  /* 4px between the sale price and the compare-at price. inline-flex sizes to its
     content (the price block is shrink-wrapped, so a block flex box collapsed to 0). */
  product-card product-price [ref='priceContainer'] {
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: baseline;
    column-gap: 4px;
    white-space: nowrap;
  }

  product-card product-price .compare-at-price {
    margin: 0;
  }

  .product-grid__card swatches-variant-picker-component overflow-list::part(list) {
    flex-wrap: wrap;
  }

  /*
    Product cards are narrow, so group content stacks on mobile. A group that
    turns "vertical on mobile" off renders without .mobile-column and keeps the
    horizontal direction it was given.
  */
  .product-grid__card .group-block > :is(.mobile-column, :not(.layout-panel-flex--row)) {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
