{% doc %}
  Header language menu: a button showing the current language code (EN, NL) that opens a
  small styled panel of the store's languages. Each language is a submit button of
  Shopify's localization form, so switching works without JavaScript; language-dropdown.js
  adds open/close, Escape and outside-click handling.

  @param {string} form_id - Unique id suffix (the header section id).
  @param {string} [style] - Inline custom properties for the header's localization font.
  @param {string} [layout] - 'dropdown' (default) or 'inline': the languages side by side
    as buttons (EN | NL), used in the mobile menu drawer. No JavaScript needed.

  @example
  {% render 'language-dropdown', form_id: section.id %}
{% enddoc %}

{%- if layout == 'inline' -%}
  <div class="language-switch">
    <span
      class="language-switch__label"
      id="LanguageSwitchLabel-{{ form_id }}"
    >
      {{- 'content.language' | t -}}
    </span>
    {%- form 'localization', id: 'LanguageSwitchForm', class: 'language-switch__form' -%}
      <div
        class="language-switch__options"
        role="group"
        aria-labelledby="LanguageSwitchLabel-{{ form_id }}"
      >
        {%- for language in localization.available_languages -%}
          <button
            type="submit"
            class="button-unstyled language-switch__option"
            name="language_code"
            value="{{ language.iso_code }}"
            lang="{{ language.iso_code }}"
            aria-label="{{ language.endonym_name | capitalize | escape }}"
            {% if language.iso_code == localization.language.iso_code %}
              aria-current="true"
            {% endif %}
          >
            {{- language.iso_code | upcase -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endform -%}
  </div>
{%- else -%}
<script
  src="{{ 'language-dropdown.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<language-dropdown class="language-dropdown">
  <button
    type="button"
    class="button-unstyled language-dropdown__toggle header-actions__action"
    aria-expanded="false"
    aria-controls="LanguageDropdown-{{ form_id }}"
    ref="toggle"
    on:click="/toggle"
    {% if style != blank %}
      style="{{ style }}"
    {% endif %}
  >
    <span class="visually-hidden">{{ 'content.language' | t }}:</span>
    <span lang="{{ localization.language.iso_code }}">{{ localization.language.iso_code | upcase }}</span>
    <span class="svg-wrapper language-dropdown__caret">
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </span>
  </button>

  <div
    class="language-dropdown__panel"
    id="LanguageDropdown-{{ form_id }}"
    ref="panel"
    hidden
  >
    {%- form 'localization', id: 'LanguageDropdownForm', class: 'language-dropdown__form' -%}
      <ul
        class="language-dropdown__list list-unstyled"
        aria-label="{{ 'content.language' | t }}"
      >
        {%- for language in localization.available_languages -%}
          {%- assign is_current = false -%}
          {%- if language.iso_code == localization.language.iso_code -%}
            {%- assign is_current = true -%}
          {%- endif -%}
          <li>
            <button
              type="submit"
              class="button-unstyled language-dropdown__option"
              name="language_code"
              value="{{ language.iso_code }}"
              lang="{{ language.iso_code }}"
              {% if is_current %}
                aria-current="true"
              {% endif %}
            >
              <span class="language-dropdown__code">{{ language.iso_code | upcase }}</span>
              <span class="language-dropdown__name">{{ language.endonym_name | capitalize }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endform -%}
  </div>
</language-dropdown>
{%- endif -%}

{% stylesheet %}
  .language-dropdown {
    position: relative;
    display: inline-flex;
  }

  .language-dropdown__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--minimum-touch-target, 44px);
    padding-inline: 0.5rem;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--menu-localization-font, var(--font-body--family));
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    cursor: pointer;

    &:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }
  }

  .language-dropdown__caret {
    width: 0.625rem;
    height: 0.625rem;
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .language-dropdown__toggle[aria-expanded='true'] .language-dropdown__caret {
    transform: rotate(180deg);
  }

  .language-dropdown__panel {
    position: absolute;
    inset-block-start: calc(100% + 0.25rem);
    inset-inline-end: 0;
    z-index: var(--layer-raised);
    min-width: 11rem;
    padding: 0.375rem;
    /* Fixed palette colours: the header can be transparent with light text over the hero. */
    border: 1px solid rgb(var(--palette-darkest-rgb) / var(--opacity-15, 0.15));
    background-color: var(--palette-lightest);
    box-shadow: 0 10px 24px rgb(var(--palette-darkest-rgb) / var(--opacity-10, 0.1));
    animation: language-dropdown-in var(--animation-speed) var(--animation-easing);
  }

  .language-dropdown__panel[hidden] {
    display: none;
  }

  .language-dropdown__form {
    margin: 0;
  }

  .language-dropdown__list {
    display: grid;
    gap: 0.125rem;
    margin: 0;
  }

  .language-dropdown__option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.625rem 0.75rem;
    background: transparent;
    color: var(--palette-darkest);
    text-align: start;
    cursor: pointer;
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);

    &:hover,
    &[aria-current='true'] {
      background-color: var(--palette-darkest);
      color: var(--palette-lightest);
    }

    &:focus-visible {
      outline: 2px solid var(--palette-darkest);
      outline-offset: -2px;
    }
  }

  .language-dropdown__code {
    min-width: 1.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .language-dropdown__name {
    font-size: 0.875rem;
  }

  @keyframes language-dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-dropdown__panel {
      animation: none;
    }

    .language-dropdown__caret,
    .language-dropdown__option {
      transition: none;
    }
  }

  /* Inline layout (mobile drawer): EN | NL as two square buttons. The drawer row only has a
     start margin, so mirror it on the end side. */
  .language-switch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding-inline-end: var(--padding-xl);
  }

  .language-switch__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .language-switch__form {
    margin: 0;
  }

  .language-switch__options {
    display: flex;
    gap: 0.5rem;
  }

  .language-switch__option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--palette-darkest);
    background: transparent;
    color: var(--palette-darkest);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);

    &:hover,
    &[aria-current='true'] {
      background-color: var(--palette-darkest);
      color: var(--palette-lightest);
    }

    &:focus-visible {
      outline: 2px solid var(--palette-darkest);
      outline-offset: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-switch__option {
      transition: none;
    }
  }
{% endstylesheet %}
