{%- doc -%}
  Renders one line icon for the Trust badges section. All icons share a 24×24 grid and a
  thin round stroke in the current text colour, so they read as one set.

  @param {string} icon - Icon name: award, truck, return, gem, gift, shield, lock, heart, chat, leaf, star.
  @param {string} [class] - Class for the svg element.

  @example
  {% render 'trust-badge-icon', icon: 'truck', class: 'trust-badges__icon' %}
{%- enddoc -%}

<svg
  class="{{ class }}"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {%- case icon -%}
    {%- when 'award' -%}
      <path d="M12 3.25Q14.1 1.43 15 4.05Q17.73 3.52 17.2 6.25Q19.82 7.15 18 9.25Q19.82 11.35 17.2 12.25Q17.73 14.98 15 14.45Q14.1 17.07 12 15.25Q9.9 17.07 9 14.45Q6.27 14.98 6.8 12.25Q4.18 11.35 6 9.25Q4.18 7.15 6.8 6.25Q6.27 3.52 9 4.05Q9.9 1.43 12 3.25Z" />
      <circle cx="12" cy="9.25" r="3.4" />
      <path d="m10.6 9.3 1 1 1.8-1.95" />
      <path d="m8.9 15.2-1.4 6.3 2.2-1.05 1.45 1.6.85-3.5" />
      <path d="m15.1 15.2 1.4 6.3-2.2-1.05-1.45 1.6-.85-3.5" />
    {%- when 'truck' -%}
      <path d="M7 16.25H6.5V6.75h8.75v9.5h-4.5" />
      <path d="M15.25 9.5h3.35l2.9 3.4v3.35h-1.25" />
      <path d="M15.25 16.25h1.5" />
      <circle cx="8.9" cy="16.6" r="1.75" />
      <circle cx="18.6" cy="16.6" r="1.75" />
      <path d="M1.75 9.25h3M2.75 11.75h2M1.75 14.25h3" />
    {%- when 'return' -%}
      <rect x="9" y="3.25" width="11.25" height="11.25" rx=".5" />
      <path d="M9 6.75h11.25" />
      <path d="M13.25 3.25v3.5M16 3.25v3.5" />
      <path d="M14.6 14.5v4.25H4" />
      <path d="m7 15.75-3 3 3 3" />
    {%- when 'gem' -%}
      <path d="M7 4.25h10l3.75 4.75L12 19.75 3.25 9Z" />
      <path d="M3.25 9h17.5" />
      <path d="M9.6 4.25 8.25 9 12 19.75 15.75 9 14.4 4.25" />
    {%- when 'gift' -%}
      <rect x="3.25" y="7.5" width="17.5" height="3.5" rx=".5" />
      <path d="M4.75 11v8.75h14.5V11" />
      <path d="M12 7.5v12.25" />
      <path d="M12 7.5C11.1 4.6 7.25 3.6 7.25 5.9 7.25 7.2 9.4 7.5 12 7.5Zm0 0c.9-2.9 4.75-3.9 4.75-1.6 0 1.3-2.15 1.6-4.75 1.6Z" />
    {%- when 'shield' -%}
      <path d="M12 3 19 5.75v5.5c0 4.5-3 7.75-7 9.25-4-1.5-7-4.75-7-9.25v-5.5Z" />
      <path d="m9.25 11.75 2 2 3.75-3.75" />
    {%- when 'lock' -%}
      <rect x="5.25" y="10.25" width="13.5" height="10" rx="1.5" />
      <path d="M8.25 10.25V7.5a3.75 3.75 0 0 1 7.5 0v2.75" />
      <path d="M12 14.25v2.25" />
    {%- when 'heart' -%}
      <path d="M12 19.75S4.25 15.1 4.25 9.6A4.1 4.1 0 0 1 12 7.6a4.1 4.1 0 0 1 7.75 2c0 5.5-7.75 10.15-7.75 10.15Z" />
    {%- when 'chat' -%}
      <path d="M4 5.25h16v10.5h-9.5L6.25 19.5v-3.75H4Z" />
      <path d="M8 9.5h8M8 12.25h5" />
    {%- when 'leaf' -%}
      <path d="M5 19.25C5 10.5 10 5 19.5 4.5 19.5 14 14 19.25 5 19.25Z" />
      <path d="m5 19.25 8.5-8.5" />
    {%- when 'star' -%}
      <path d="m12 3.5 2.6 5.3 5.8.85-4.2 4.1 1 5.8L12 16.8l-5.2 2.75 1-5.8-4.2-4.1 5.8-.85Z" />
  {%- endcase -%}
</svg>
