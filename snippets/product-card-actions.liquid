{%- doc -%}
  Zorelle product card call-to-action, overlaid at the bottom of the card image.
  It fades up on card hover (always visible on touch screens) and adapts to the product:
  - tagged "personalized"  -> "Personalise" link to the product page
  - sold out               -> disabled "Sold out"
  - one variant            -> "Add to cart" (adds directly)
  - one option, many sizes -> "Add to cart" that reveals size buttons; a size adds that variant
                              (options with a single value, e.g. one Color, are ignored)
  - several options        -> "Choose" link to the product page
  Add to cart uses Horizon's product-form-component, so the cart drawer and
  fly-to-cart behaviour are unchanged.

  @param {object} product - The product.
  @param {string} section_id - The section ID (for the product form).
  @param {string} [personalize_label] - Label for personalised products.
  @param {string} [size_heading] - Heading of the size popover on screens up to 1024px.

  Up to 1024px the CTA collapses to a square cart icon at the bottom-right of the image;
  in size mode it opens a popover with the size buttons above the icon.

  @example
  {% render 'product-card-actions', product: product, section_id: section.id, personalize_label: 'Personalise', size_heading: 'Select size / option' %}
{%- enddoc -%}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign add_label = 'actions.add_to_cart' | t
  assign form_id = 'CardActions-' | append: section_id | append: '-' | append: product.id
  assign cart_icon = 'icon-add-to-cart.svg' | inline_asset_content

  # Only options with more than one value need a choice; a single-value option
  # (e.g. Color: 925 Sterling Silver) is fixed and doesn't force "Choose".
  assign choice_count = 0
  for product_option in product.options_with_values
    if product_option.values.size > 1
      assign choice_count = choice_count | plus: 1
      assign size_option = product_option
    endif
  endfor

  assign mode = 'sizes'
  if product.tags contains 'personalized'
    assign mode = 'personalize'
  elsif product.available == false
    assign mode = 'sold-out'
  elsif product.requires_selling_plan or choice_count > 1
    assign mode = 'choose'
  elsif product.variants_count == 1
    assign mode = 'single'
  endif
%}

<script src="{{ 'product-card-actions.js' | asset_url }}" type="module" fetchpriority="low"></script>

<card-actions class="card-actions card-actions--{{ mode }}">
  {%- case mode -%}
    {%- when 'personalize' -%}
      <a href="{{ product.url }}" class="button-secondary card-actions__button">
        <span class="card-actions__label">{{- personalize_label | default: 'Personalise' | escape -}}</span>
        <span class="card-actions__icon" aria-hidden="true">{{ cart_icon }}</span>
      </a>

    {%- when 'sold-out' -%}
      <button type="button" class="button-secondary card-actions__button" disabled>
        {{- 'blocks.sold_out' | t -}}
      </button>

    {%- when 'choose' -%}
      <a href="{{ product.url }}" class="button-secondary card-actions__button">
        <span class="card-actions__label">{{- 'actions.choose' | t -}}</span>
        <span class="card-actions__icon" aria-hidden="true">{{ cart_icon }}</span>
      </a>

    {%- when 'single' -%}
      <product-form-component
        data-section-id="{{ section_id }}"
        data-product-id="{{ product.id }}"
        on:submit="/handleSubmit"
        class="card-actions__form"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="{{ variant.quantity_rule.min | default: 1 }}">
          <button type="submit" name="add" class="button-secondary card-actions__button">
            <span class="card-actions__label">{{- add_label -}}</span>
            <span class="card-actions__icon" aria-hidden="true">{{ cart_icon }}</span>
          </button>
        {%- endform -%}
      </product-form-component>

    {%- when 'sizes' -%}
      {%- liquid
        assign option = size_option | default: product.options_with_values.first
        assign option_index = option.position | minus: 1
      -%}
      {%- assign sizes_id = form_id | append: '-sizes' -%}
      <button
        type="button"
        class="button-secondary card-actions__button card-actions__toggle"
        aria-expanded="false"
        aria-controls="{{ sizes_id }}"
        data-card-actions-toggle
      >
        <span class="card-actions__label">{{- add_label -}}</span>
        <span class="card-actions__icon" aria-hidden="true">{{ cart_icon }}</span>
      </button>
      <product-form-component
        data-section-id="{{ section_id }}"
        data-product-id="{{ product.id }}"
        on:submit="/handleSubmit"
        class="card-actions__form"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <div
            id="{{ sizes_id }}"
            class="card-actions__sizes"
            role="group"
            aria-label="{{ option.name | escape }}"
          >
            <p class="card-actions__heading" aria-hidden="true">
              {{- size_heading | default: 'Select size / option' | escape -}}
            </p>
            <button
              type="button"
              class="card-actions__scroll card-actions__scroll--prev"
              aria-label="{{ 'content.pagination.previous' | t }}"
              data-card-actions-scroll="prev"
              hidden
            >
              <svg aria-hidden="true" focusable="false" viewBox="0 0 10 16">
                <path d="M8 2L2 8l6 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
              </svg>
            </button>
            <div class="card-actions__track" data-card-actions-track>
              {%- for v in product.variants -%}
                <button
                  type="button"
                  class="card-actions__size"
                  data-variant-id="{{ v.id }}"
                  aria-label="{{ add_label }}: {{ v.options[option_index] | escape }}"
                  {% unless v.available %}
                    disabled
                  {% endunless %}
                >
                  {{- v.options[option_index] | escape -}}
                </button>
              {%- endfor -%}
            </div>
            <button
              type="button"
              class="card-actions__scroll"
              aria-label="{{ 'content.pagination.next' | t }}"
              data-card-actions-scroll="next"
              hidden
            >
              <svg aria-hidden="true" focusable="false" viewBox="0 0 10 16">
                <path d="M2 2l6 6-6 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        {%- endform -%}
      </product-form-component>
  {%- endcase -%}
</card-actions>

{% stylesheet %}
  /*
    Product card CTA. Uses the shared button system (assets/buttons.css) with a light
    card surface; hover fills with the foreground colour (the "normal" button hover).
    Above 1024px: full-width bar that fades up on hover. Up to 1024px: square cart icon
    at the bottom-right of the image, with the size popover above it.
  */
  .card-actions {
    --card-actions-inset: 0.75rem;
    --card-actions-icon-size: 2.75rem;

    /* Page-level palette colours: product cards can set --color-background to
       transparent, which made the button see-through. */
    --card-actions-surface: var(--palette-lightest);
    --card-actions-ink: var(--palette-darkest);

    position: absolute;
    inset: auto var(--card-actions-inset) var(--card-actions-inset);
    z-index: 3;
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 0.35s var(--ease-out-quad, ease-out),
      transform 0.35s var(--ease-out-quad, ease-out);
    pointer-events: none;
  }

  .card-actions__form {
    display: block;
  }

  /* Light surface at rest; solid dark fill with light text on hover/focus (no sweep). */
  .card-actions__button.button-secondary {
    --button-color: var(--card-actions-ink);
    --button-background-color: var(--card-actions-surface);
    --btn-rest-background: var(--card-actions-surface);
    --button-border-color: rgb(var(--palette-darkest-rgb) / var(--opacity-20, 0.2));
    --btn-min-height: 2.75rem;
    --btn-padding-block: 0.75rem;

    width: 100%;
    font-size: 0.75rem;
    background-image: none;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .card-actions__button.button-secondary:is(:hover, :focus-visible):not(:disabled) {
    --button-color: var(--card-actions-surface);
    --button-background-color: var(--card-actions-ink);
    --button-border-color: var(--card-actions-ink);
  }

  .card-actions__button[disabled] {
    opacity: 0.7;
  }

  .card-actions__icon,
  .card-actions__heading {
    display: none;
  }

  /* Size picker. Hidden with visibility (not display: none) so the list keeps its
     layout and scroll position between hovers. Hidden content is also not focusable. */
  .card-actions__sizes {
    position: absolute;
    inset: 0;
    display: flex;
    visibility: hidden;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem;
    background: var(--card-actions-surface);
    box-shadow: inset 0 0 0 1px rgb(var(--palette-darkest-rgb) / var(--opacity-20, 0.2));
  }

  .card-actions__track {
    display: flex;
    flex: 1;
    gap: 0.375rem;
    min-width: 0;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .card-actions__track::-webkit-scrollbar {
    display: none;
  }

  .card-actions__size {
    flex: 0 0 auto;
    min-width: 2.5rem;
    height: 2rem;
    padding: 0 0.625rem;
    border: 1px solid rgb(var(--palette-darkest-rgb) / var(--opacity-20, 0.2));
    background: transparent;
    color: var(--card-actions-ink);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;

    /* [data-added]: the size just added, shown as selected until the picker closes. */
    &:hover,
    &:focus-visible,
    &[data-added] {
      background: var(--card-actions-ink);
      border-color: var(--card-actions-ink);
      color: var(--card-actions-surface);
    }

    &:focus-visible {
      outline: 2px solid var(--card-actions-ink);
      outline-offset: 1px;
    }

    &:disabled {
      opacity: 0.4;
      text-decoration: line-through;
      cursor: not-allowed;
      background: transparent;
      color: var(--card-actions-ink);
    }
  }

  .card-actions__scroll {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.5rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--card-actions-ink);
    cursor: pointer;

    &[hidden] {
      display: none;
    }

    svg {
      width: 0.5rem;
      height: 0.8rem;
    }
  }

  /* ---------- Above 1024px: full-width bar ---------- */
  @media (min-width: 1025px) {
    /* Fade in up on card hover / keyboard focus. */
    .product-card:hover .card-actions,
    .card-gallery:hover .card-actions,
    /* :focus-visible only: keyboard focus keeps it open, mouse clicks do not. */
    .card-actions:has(:focus-visible),
    .card-actions[open] {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .card-actions--sizes[open] .card-actions__sizes,
    .card-actions--sizes:has(.card-actions__sizes :focus-visible) .card-actions__sizes {
      visibility: visible;
    }

    .card-actions--sizes[open] .card-actions__toggle,
    .card-actions--sizes:has(.card-actions__sizes :focus-visible) .card-actions__toggle {
      visibility: hidden;
    }
  }

  @media (min-width: 1025px) and (hover: hover) {
    .card-actions--sizes:hover .card-actions__sizes {
      visibility: visible;
    }

    .card-actions--sizes:hover .card-actions__toggle {
      visibility: hidden;
    }
  }

  /* Large touch screens have no hover: keep the bar visible. */
  @media (min-width: 1025px) and (hover: none) {
    .card-actions {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  /* ---------- Up to 1024px: cart icon + size popover ---------- */
  @media (max-width: 1024px) {
    /* Spans the image so the popover can use its width; only the icon and the
       popover take taps, the rest of the image stays tappable. */
    .card-actions {
      display: flex;
      justify-content: flex-end;
      opacity: 1;
      transform: none;
    }

    .card-actions--sold-out {
      display: none;
    }

    /* Android Chrome highlights the whole clickable product card on tap; the icon
       and size buttons give their own press feedback instead. */
    .product-card:has(.card-actions),
    .card-actions * {
      -webkit-tap-highlight-color: transparent;
    }

    .card-actions .card-actions__button.button-secondary {
      --button-color: var(--card-actions-surface);
      --button-background-color: var(--card-actions-ink);
      --button-border-color: var(--card-actions-ink);
      --btn-min-height: var(--card-actions-icon-size);

      display: grid;
      place-items: center;
      width: var(--card-actions-icon-size);
      height: var(--card-actions-icon-size);
      padding: 0;
      pointer-events: auto;
      touch-action: manipulation;
      transition: transform 0.15s var(--ease-out-quad, ease-out);
    }

    .card-actions .card-actions__button.button-secondary:active,
    .card-actions .card-actions__size:active:not(:disabled) {
      transform: scale(0.92);
    }

    .card-actions .card-actions__size {
      touch-action: manipulation;
      transition: transform 0.15s var(--ease-out-quad, ease-out), background-color 0.2s ease, color 0.2s ease;
    }

    .card-actions__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .card-actions__icon {
      display: grid;
      place-items: center;

      svg {
        width: 1.375rem;
        height: 1.375rem;
      }
    }

    /* The form only hosts the popover here; it takes no space in the row. */
    .card-actions--sizes .card-actions__form {
      display: contents;
    }

    .card-actions--sizes .card-actions__sizes {
      inset: auto 0 calc(100% + 0.625rem);
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      /* Never taller than the image area above the cart icon: the card gallery clips
         overflow, so a taller popover lost its top on small cards. Image height =
         gallery width (100cqw, the gallery is an inline-size container) / its ratio.
         Anything that still doesn't fit scrolls inside the popover. */
      max-height: min(
        18rem,
        calc(
          100cqw / (var(--gallery-aspect-ratio, 1)) - var(--card-actions-icon-size) - var(--card-actions-inset) * 2 -
            0.625rem
        )
      );
      padding: 1rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      opacity: 0;
      transform: translateY(0.375rem);
      box-shadow: 0 0.5rem 1.5rem rgb(var(--palette-darkest-rgb) / var(--opacity-20, 0.2));
      /* Closing: a slower fade so the chosen size stays readable as it leaves. */
      transition:
        opacity 0.5s var(--ease-out-quad, ease-out),
        transform 0.5s var(--ease-out-quad, ease-out),
        visibility 0s linear 0.5s;
    }

    .card-actions--sizes[open] .card-actions__sizes {
      visibility: visible;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      transition:
        opacity 0.25s var(--ease-out-quad, ease-out),
        transform 0.25s var(--ease-out-quad, ease-out);
    }

    .card-actions__heading {
      display: block;
      margin: 0;
      color: rgb(var(--palette-darkest-rgb) / var(--opacity-70, 0.7));
      font-family: var(--font-body--family);
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    /* Grid that stretches its columns to the full popover width (no empty gap on the
       right); as many ~3.5rem columns as fit. */
    .card-actions__track {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.5rem;
      overflow: visible;
    }

    .card-actions .card-actions__size {
      min-width: 0;
      padding: 4px;
      font-size: 13px;
    }

    .card-actions .card-actions__scroll {
      display: none;
    }

    /* The image slider arrows would sit on top of the open popover. */
    .card-gallery:has(.card-actions[open]) slideshow-arrows {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-actions,
    .card-actions__sizes,
    .card-actions__track {
      transition: none;
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}
