{% doc %}
  Product Media Gallery Content

  Renders product media gallery for the closest product.

  @param {string} media_presentation - Either 'grid' or 'carousel'
  @param {object} block_settings - Block settings object
  @param {string} block_id - Block ID for unique element IDs
  @param {string} block_shopify_attributes - Block shopify attributes
  @param {block} block - The current block object
  @param {section} section - The current section object

  @example
  {% render 'product-media-gallery-content',
    media_presentation: 'carousel',
    block_settings: block.settings,
    block_id: block.id,
    block_shopify_attributes: block.shopify_attributes,
  %}
{% enddoc %}
{%- if block_settings.zoom -%}
  <script
    src="{{ 'zoom-dialog.js' | asset_url }}"
    type="module"
  ></script>
{%- endif -%}
{%- liquid
  assign selected_product = closest.product
  assign selected_variant_media = selected_product.selected_or_first_available_variant.featured_media

  if block_settings.hide_variants and selected_variant_media == blank
    assign selected_variant_media = selected_product.featured_media
  endif

  assign first_3d_model = selected_product.media | where: 'media_type', 'model' | first

  if block_settings.hide_variants
    assign variant_images = selected_product.images | where: 'attached_to_variant?', true | map: 'src'
  endif

  if block_settings.slideshow_controls_style == 'thumbnails'
    assign controls_on_media = false
  else
    assign controls_on_media = true
  endif

  if block_settings.slideshow_mobile_controls_style == 'thumbnails'
    assign mobile_controls_on_media = false
  else
    assign mobile_controls_on_media = true
  endif

  assign render_slideshow_controls = false

  if media_presentation == 'carousel' or block_settings.slideshow_controls_style == block_settings.slideshow_mobile_controls_style
    assign render_slideshow_controls = true
  endif

  assign render_mobile_slideshow_controls = false

  if block_settings.slideshow_controls_style != block_settings.slideshow_mobile_controls_style
    assign slideshow_controls_class = 'mobile:hidden'

    if block_settings.slideshow_mobile_controls_style != 'hint'
      assign render_mobile_slideshow_controls = true
    endif
  endif

  assign slideshow_controls_style = block_settings.slideshow_controls_style
  # Use a counter instead of dots when there are many images to avoid cropping/overflow.
  if slideshow_controls_style == 'dots' and selected_product.media.size > 15
    assign slideshow_controls_style = 'counter'
  endif

  assign render_slideshow_arrows = false

  if selected_product.media.size <= 1
    assign slideshow_class = 'product-media-gallery__slideshow--single-media slideshow--single-media'
  else
    assign slideshow_class = ''

    if media_presentation == 'carousel'
      assign render_slideshow_arrows = true
    endif
  endif

  # Carousel arrows are always visible, so they don't animate in on hover
  assign animate_arrows = true
  if media_presentation == 'carousel'
    assign animate_arrows = false
  endif

  if slideshow_controls_style == 'thumbnails'
    assign pagination_position = block_settings.thumbnail_position
  else
    assign pagination_position = 'center'
  endif

  # correct discrepancy between position settings for thumbnails and other controls
  if pagination_position == 'bottom'
    assign pagination_position = 'center'
  endif

  assign icons_position = 'center'

  # Put the icons on the opposite side of the pagination controls
  if block_settings.slideshow_controls_position == 'on_media'
    if pagination_position == 'left'
      assign icons_position = 'right'
    elsif pagination_position == 'right'
      assign icons_position = 'left'
    endif
  endif

  assign sorted_media = '' | split: ','
  if selected_variant_media
    assign sorted_media = sorted_media | concat: selected_product.media | where: 'id', selected_variant_media.id

    for media in selected_product.media
      if block_settings.hide_variants and variant_images contains media.src and sorted_media.size > 0
        continue
      endif

      if media.id != selected_variant_media.id
        assign found_media = selected_product.media | where: 'id', media.id
        assign sorted_media = sorted_media | concat: found_media
      endif
    endfor
  elsif block_settings.hide_variants
    assign sorted_media = '' | split: ','
  else
    assign sorted_media = selected_product.media
  endif
  assign has_image_drop = sorted_media | has: 'media_type', 'image'

  # Determine if we're in single column mode (carousel or grid with one column)
  assign is_single_column = false
  if media_presentation == 'carousel' or sorted_media.size == 1 or media_presentation == 'grid' and block_settings.media_columns == 'one'
    assign is_single_column = true
  endif

  # Check if we need both sizes (for large first image in two-column grid)
  assign needs_both_sizes = false
  if media_presentation == 'grid' and block_settings.media_columns == 'two' and block_settings.large_first_image
    assign needs_both_sizes = true
  endif

  # Calculate sizes using utility snippet
  if needs_both_sizes
    # Calculate sizes for single column (first image)
    capture sizes_single
      render 'util-product-media-sizes-attr', block: block, section: section, settings: settings, is_first_image: true, is_single_column: true, needs_both_sizes: true
    endcapture
    assign sizes_single = sizes_single | strip
  endif

  # Calculate sizes value for regular grid/carousel items
  capture sizes
    render 'util-product-media-sizes-attr', block: block, section: section, settings: settings, is_first_image: false, is_single_column: is_single_column, needs_both_sizes: needs_both_sizes
  endcapture
  assign sizes = sizes | strip

  assign product_media_container_class = 'product-media-container'
  if block_settings.constrain_to_viewport
    assign product_media_container_class = product_media_container_class | append: ' constrain-height'
  endif
  if block_settings.aspect_ratio != 'adapt'
    assign product_media_container_class = product_media_container_class | append: ' media-fit-cover'
  elsif block_settings.constrain_to_viewport
    assign product_media_container_class = product_media_container_class | append: ' media-fit-' | append: block_settings.media_fit
  else
    assign product_media_container_class = product_media_container_class | append: ' media-fit-contain'
  endif

  if block_settings.aspect_ratio == 'adapt'
    assign lowest_aspect_ratio = 50
    assign lowest_aspect_ratio_index = 0

    for media in sorted_media
      # Find the media with the lowest aspect ratio (tallest)

      if media.preview_image and media.preview_image.aspect_ratio
        if media.preview_image.aspect_ratio < lowest_aspect_ratio
          assign lowest_aspect_ratio = media.preview_image.aspect_ratio
          assign lowest_aspect_ratio_index = forloop.index0
        endif
      endif
    endfor
  endif
-%}

{%- if block_settings.constrain_to_viewport -%}
  {% # `.constrain-height` consumes `--header-height` at first paint (product-media-container-styles.liquid) %}
  {% render 'measure-header-heights', only_on_desktop: true %}
{%- endif -%}

{% style %}
  {% unless block_settings.aspect_ratio == 'adapt' %}
    .product-media-container {
      --media-preview-ratio: {{ block_settings.aspect_ratio }};
    }

    {% if block_settings.constrain_to_viewport %}
      .product-media-container.constrain-height {
        background-color: var(--color-background);
      }

      .product-media-container.constrain-height:has(.product-media-constraint-wrapper) {
        display: flex;
        justify-content: center;
        align-items: center;
      }

      /* Mobile constraint wrapper sizing - use width-based approach since max-height is disabled */
      .product-media-constraint-wrapper {
        width: 100%;
        max-width: 100%;
        flex-shrink: 0;
      }

      /* Desktop constraint wrapper sizing */
      @media screen and (min-width: 750px) {
        .product-media-constraint-wrapper {
          width: min(100%, calc(var(--constrained-height) * {{ block_settings.aspect_ratio }}));
        }
      }
    {% endif %}

    /* Constrain all deferred-media content to parent bounds when specific aspect ratio is set */
    .product-media-container:not(.dialog-zoomed-gallery *) .product-media deferred-media,
    .product-media-container:not(.dialog-zoomed-gallery *) .product-media product-model {
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
    }

    /* Ensure video and iframe elements respect container aspect ratio */
    .product-media-container:not(.dialog-zoomed-gallery *) .product-media deferred-media video,
    .product-media-container:not(.dialog-zoomed-gallery *) .product-media deferred-media iframe {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* 3D models need special handling since they don't support object-fit */
    .product-media-container:not(.dialog-zoomed-gallery *) .product-media product-model model-viewer {
      width: 100%;
      height: 100%;
    }

    /* Clear gallery aspect ratio for zoom dialog - let media display at natural aspect ratios */
    .dialog-zoomed-gallery .product-media {
      --gallery-aspect-ratio: var(--ratio);
    }
  {% endunless %}

  {% if block_settings.aspect_ratio == 'adapt' and block_settings.constrain_to_viewport %}
    .media-fit-{{ block_settings.media_fit }} {
      --product-media-fit: {{ block_settings.media_fit }};
    }

    /* Media fit for all media elements */
    .media-fit-{{ block_settings.media_fit }} :is(img, video, iframe, .deferred-media__poster-image) {
      object-fit: {{ block_settings.media_fit }};
      width: 100%;
      height: 100%;
    }

    /* 3D Models (no object-fit support, just sizing) */
    .media-fit-{{ block_settings.media_fit }} model-viewer {
      width: 100%;
      height: 100%;
    }
  {% endif %}

  {% unless block_settings.aspect_ratio == 'adapt' and block_settings.constrain_to_viewport %}
    .media-fit-cover {
      --product-media-fit: cover;
    }

    /* Media fit for all media elements - default to cover */
    .media-fit-cover :is(img, video, iframe, .deferred-media__poster-image) {
      object-fit: cover;
      width: 100%;
      height: 100%;
    }

    /* 3D Models (no object-fit support, just sizing) */
    .media-fit-cover model-viewer {
      width: 100%;
      height: 100%;
    }
  {% endunless %}

  /* Add background color so carousel arrows' mix-blend-mode works correctly even on transparent areas. */
  {% if block_settings.media_fit == 'contain' %}
    .media-fit-contain :is(img, .deferred-media__poster-image) {
      background-color: var(--color-background);
    }
  {% endif %}

{% endstyle %}

{% if closest.product == blank %}
  <div
    class="
      {% if block_settings.extend_media %}
        media-gallery--extend
      {% endif %}
    "
    {{ block_shopify_attributes }}
  >
    {{ 'product-apparel-1' | placeholder_svg_tag: 'product-media-gallery__placeholder-image' }}
  </div>
{% else %}
  {%- comment -%} Zorelle: setting-driven vars in a scoped style block, not inline. {%- endcomment -%}
  {% style %}
    media-gallery.media-gallery--block-{{ block.id }} {
      {% render 'spacing-style', settings: block_settings %}
      --thumbnail-width: {{ block_settings.thumbnail_width }}px;
      --media-radius: {{ block_settings.media_radius }}px;
      {%- if block_settings.icons_style contains 'large' %}
        --slideshow-icon-padding: 0px;
      {%- endif %}
      --image-gap: {{ block_settings.image_gap }}px;
      {%- unless block_settings.aspect_ratio == 'adapt' %}
        --gallery-aspect-ratio: {{ block_settings.aspect_ratio }};
      {%- endunless %}
    }

    media-gallery.media-gallery--block-{{ block.id }} slideshow-controls {
      --thumbnail-radius: {{ block_settings.thumbnail_radius }}px;
    }
  {% endstyle %}
  <media-gallery
    class="
      media-gallery--block-{{ block.id }}
      spacing-style
      sticky-content
      {% if media_presentation == 'grid' %}
        media-gallery--{{ block_settings.media_columns }}-column
        {% if block_settings.media_columns == "two" and block_settings.large_first_image%}media-gallery--large-first-image{% endif %}
      {% endif %}
      media-gallery--{{ media_presentation }}
      {% if block_settings.slideshow_mobile_controls_style == 'hint' %}
        media-gallery--hint
      {% endif %}
      {% if block_settings.extend_media %}
        media-gallery--extend
      {% endif %}
    "
    data-presentation="{{ media_presentation }}"
    {{ block_shopify_attributes }}
  >
    {% capture slides %}
      {% for media in sorted_media %}
        {% capture children %}
          {%- liquid
              if needs_both_sizes and forloop.first
                assign media_sizes = sizes_single
              else
                assign media_sizes = sizes
              endif
          -%}
          {% if block_settings.aspect_ratio != 'adapt' and block_settings.constrain_to_viewport %}
            <div
              class="product-media-constraint-wrapper">
              {%- render 'product-media', media: media, sizes: media_sizes, is_main_product_media: forloop.first -%}
            </div>
          {% else %}
            {%- render 'product-media', media: media, sizes: media_sizes, is_main_product_media: forloop.first -%}
          {% endif %}
          {%- comment -%}
            Zorelle: magnifier button for keyboard and pointer users. It has no handler of
            its own; its click bubbles to the slide's on:click, which opens the viewer here.
          {%- endcomment -%}
          {%- if block_settings.zoom and media.media_type == 'image' -%}
            <button
              type="button"
              class="button button-unstyled media-gallery__zoom-button"
              aria-label="{{ 'actions.zoom_media' | t: index: forloop.index }}"
            >
              {{- 'icon-search.svg' | inline_asset_content -}}
            </button>
          {%- endif -%}
        {% endcapture %}
        {% capture class %}
          {{ product_media_container_class }} product-media-container--{{ media.media_type }}{% if block_settings.zoom %} product-media-container--zoomable{% endif %}{% if forloop.index0 == lowest_aspect_ratio_index and block_settings.aspect_ratio == 'adapt' %} product-media-container--tallest{% endif %}
        {% endcapture %}
        {% if block_settings.aspect_ratio == 'adapt' %}
          {% capture style %}
            --media-preview-ratio: {{ media.preview_image.aspect_ratio | default: 1.0 }};
          {% endcapture %}
        {% endif %}
        {% if block_settings.zoom and media.media_type == 'model' %}
          {%- capture attributes -%}"{% if settings.transition_to_main_product and forloop.first %} data-view-transition-type="product-image-transition"{% endif %}{% endcapture -%}
        {% elsif block_settings.zoom %}
          {%- capture attributes -%}on:click="#zoom-dialog-{{ block_id }}/open/{{ forloop.index0 }}"{% if settings.transition_to_main_product and forloop.first %} data-view-transition-type="product-image-transition"{% endif %}{% endcapture -%}
        {% endif %}

        {% render 'slideshow-slide',
          index: forloop.index0,
          children: children,
          class: class,
          style: style,
          attributes: attributes,
          media_fit: block_settings.media_fit,
        %}
      {% endfor %}
    {% endcapture %}

    {% if sorted_media.size > 1 %}
      {% capture controls %}
        {% if render_slideshow_controls %}
          {%- render 'slideshow-controls',
            class: slideshow_controls_class,
            style: slideshow_controls_style,
            item_count: sorted_media.size,
            thumbnails: sorted_media,
            controls_on_media: controls_on_media,
            pagination_position: pagination_position,
            aspect_ratio: block_settings.aspect_ratio
          -%}
        {% endif %}

        {% if render_mobile_slideshow_controls %}
          {%- render 'slideshow-controls',
            class: 'desktop:hidden media-gallery__mobile-controls',
            style: block_settings.slideshow_mobile_controls_style,
            item_count: sorted_media.size,
            thumbnails: sorted_media,
            controls_on_media: mobile_controls_on_media,
            pagination_position: 'center',
            aspect_ratio: block_settings.aspect_ratio
          -%}
        {% endif %}
      {% endcapture %}
    {% endif %}

    {% if render_slideshow_arrows %}
      {% capture slideshow_arrows %}
        {% render 'slideshow-arrows', class: 'mobile:hidden', icon_style: block_settings.icons_style %}
      {% endcapture %}
    {% endif %}

    {%- comment -%}
      Zorelle: "1 / 3" image counter over the image (shown at 960px and below, CSS).
      Rendered with the arrows so it sits inside slideshow-container; kept in step by
      media-gallery-counter.js. Thumbnail buttons already announce the slide, so it is
      hidden from screen readers.
    {%- endcomment -%}
    {%- if media_presentation == 'carousel' and sorted_media.size > 1 -%}
      {% capture slideshow_arrows %}
        {{- slideshow_arrows -}}
        <span class="media-gallery__counter" aria-hidden="true">
          <span data-media-counter-current>1</span> / {{ sorted_media.size }}
        </span>
      {% endcapture %}
      <script src="{{ 'media-gallery-counter.js' | asset_url }}" type="module" fetchpriority="low"></script>
    {%- endif -%}

    {% render 'slideshow',
      ref: 'slideshow',
      class: slideshow_class,
      slides: slides,
      slide_count: sorted_media.size,
      slideshow_arrows: slideshow_arrows,
      arrows_position: icons_position,
      animate_arrows: animate_arrows,
      controls: controls
    %}

    {% if media_presentation == 'grid' %}
      <ul
        class="media-gallery__grid list-unstyled"
        data-testid="media-gallery-grid"
      >
        {% for media in sorted_media %}
          <li
            ref="media[]"
            class="{{ product_media_container_class }} product-media-container--{{ media.media_type }} {% unless block_settings.aspect_ratio == 'adapt' %}product-media-container--force-aspect{% endunless %}"
            style="{% if block_settings.aspect_ratio == 'adapt' %} --media-preview-ratio: {{ media.preview_image.aspect_ratio | default: 1.0 }};{% endif %} --media-radius: {{ block_settings.media_radius }}px;"
            {% if settings.transition_to_main_product and forloop.first %}
              data-view-transition-type="product-image-transition"
            {% endif %}
            {% if media.presentation.focal_point != blank %}
              data-focal-point="{{ media.presentation.focal_point }}"
            {% endif %}
          >
            {%- if block_settings.zoom and media.media_type == 'image' -%}
              <button
                type="button"
                class="button button-unstyled product-media-container__zoom-button"
                aria-label="{{ 'actions.zoom_media' | t: index: forloop.index }}"
                on:click="/zoom/{{ forloop.index0 }}"
                {% if block_settings.zoom %}
                  on:pointerenter="/preloadImage/{{ forloop.index0 }}"
                {% endif %}
              ></button>
            {%- endif -%}
            {%- liquid
              if needs_both_sizes and forloop.first
                assign media_sizes = sizes_single
              else
                assign media_sizes = sizes
              endif
            -%}
            {% if block_settings.aspect_ratio != 'adapt' and block_settings.constrain_to_viewport %}
              <div class="product-media-constraint-wrapper">
                {%- render 'product-media', media: media, sizes: media_sizes, is_main_product_media: forloop.first -%}
              </div>
            {% else %}
              {%- render 'product-media', media: media, sizes: media_sizes, is_main_product_media: forloop.first -%}
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {%- if block_settings.zoom -%}
      {%- comment -%}
        Zorelle image viewer: a dark full-screen dialog showing one media item at a
        time, with a counter, previous / next buttons and click-to-zoom (zoom-dialog.js).
        The track keeps the dialog-zoomed-gallery class so gallery-only media rules stay
        excluded from it.
      {%- endcomment -%}
      {%- liquid
        assign zoom_hint = block_settings.zoom_hint | strip
        assign zoom_hint_touch = block_settings.zoom_hint_touch | strip
        if zoom_hint_touch == blank
          assign zoom_hint_touch = zoom_hint
        endif
      -%}
      <zoom-dialog
        ref="zoomDialogComponent"
        id="zoom-dialog-{{ block_id }}"
        class="zoom-viewer"
      >
        <dialog
          class="dialog-zoomed-gallery__dialog zoom-viewer__dialog"
          ref="dialog"
          aria-label="{{ selected_product.title | escape }}"
          on:keydown="/handleKeyDown"
        >
          <div class="zoom-viewer__bar">
            {%- if sorted_media.size > 1 -%}
              <p
                class="zoom-viewer__counter"
                aria-hidden="true"
              >
                <span ref="counter">1</span> / {{ sorted_media.size }}
              </p>
            {%- endif -%}
            <button
              type="button"
              class="button button-unstyled zoom-viewer__button zoom-viewer__close"
              aria-label="{{ 'actions.close' | t }}"
              on:click="/close"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>

          {%- if sorted_media.size > 1 -%}
            <p
              class="visually-hidden"
              role="status"
              ref="status"
              data-template="{{ 'accessibility.slide_status' | t: index: '[index]', length: sorted_media.size | escape }}"
            ></p>
          {%- endif -%}

          <ul class="dialog-zoomed-gallery zoom-viewer__track list-unstyled">
            {%- for media in sorted_media -%}
              <li
                id="product-{{ media.id }}-{{ forloop.index }}"
                class="{{ product_media_container_class | remove: 'media-fit-cover' }} product-media-container--{{ media.media_type }} zoom-viewer__slide"
                ref="media[]"
                {% if forloop.first %}
                  data-active
                  aria-hidden="false"
                {% else %}
                  aria-hidden="true"
                  inert
                {% endif %}
              >
                {%- if media.media_type == 'image' -%}
                  <div
                    class="zoom-viewer__frame"
                    data-zoom-frame
                  >
                    {%- render 'product-media',
                      media: media,
                      sizes: '100vw',
                      loading: 'lazy',
                      is_main_product_media: forloop.first,
                      image_ref: 'image'
                    -%}
                  </div>
                {%- else -%}
                  {%- render 'product-media',
                    media: media,
                    sizes: '100vw',
                    loading: 'lazy',
                    is_main_product_media: forloop.first
                  -%}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if sorted_media.size > 1 -%}
            <button
              type="button"
              class="button button-unstyled zoom-viewer__button zoom-viewer__arrow zoom-viewer__arrow--previous"
              aria-label="{{ 'accessibility.slideshow_previous' | t }}"
              on:click="/previous"
            >
              {{- 'icon-chevron-left.svg' | inline_asset_content -}}
            </button>
            <button
              type="button"
              class="button button-unstyled zoom-viewer__button zoom-viewer__arrow zoom-viewer__arrow--next"
              aria-label="{{ 'accessibility.slideshow_next' | t }}"
              on:click="/next"
            >
              {{- 'icon-chevron-right.svg' | inline_asset_content -}}
            </button>
          {%- endif -%}

          {%- if has_image_drop and zoom_hint != blank -%}
            <p class="zoom-viewer__hint">
              <span class="zoom-viewer__hint-text zoom-viewer__hint-text--pointer">{{ zoom_hint | escape }}</span>
              <span class="zoom-viewer__hint-text zoom-viewer__hint-text--touch">{{ zoom_hint_touch | escape }}</span>
            </p>
          {%- endif -%}
        </dialog>
      </zoom-dialog>
    {%- endif -%}

    {%- if first_3d_model -%}
      <link
        id="ModelViewerStyle"
        rel="stylesheet"
        href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
        media="print"
        onload="this.media='all'"
      >
      <script>
        window.ProductModel = {
          loadShopifyXR() {
            Shopify.loadFeatures([
              {
                name: 'shopify-xr',
                version: '1.0',
                onLoad: this.setupShopifyXR.bind(this),
              },
            ]);
          },

          setupShopifyXR(errors) {
            if (errors) return;

            if (!window.ShopifyXR) {
              document.addEventListener('shopify_xr_initialized', () => this.setupShopifyXR());
              return;
            }

            document.querySelectorAll('[id^="ProductModelJSON-"]').forEach((modelJSON) => {
              window.ShopifyXR.addModels(JSON.parse(modelJSON.textContent));
              modelJSON.remove();
            });
            window.ShopifyXR.setupXRElements();
          },
        };

        window.ProductModel.loadShopifyXR();
      </script>
    {%- endif -%}
  </media-gallery>
{% endif %}

{% render 'product-media-container-styles' %}
{% render 'product-media-gallery-content-styles' %}

{% stylesheet %}
  /* 3D model controls in the viewer: bottom inline-end corner. */
  .dialog-zoomed-gallery .shopify-model-viewer-ui__controls-area.shopify-model-viewer-ui__controls-area {
    bottom: var(--padding-lg);
    inset-inline-end: var(--padding-lg);
  }

  /* The external model-viewer UI stylesheet positions the controls with a physical
     right; inset-inline-end maps to left in RTL, so clear the stale right to stop
     the auto-width controls being constrained on both sides */
  [dir='rtl'] .dialog-zoomed-gallery .shopify-model-viewer-ui__controls-area.shopify-model-viewer-ui__controls-area {
    right: auto; /* stylelint-disable-line csstools/use-logical -- clearing an external physical right in RTL */
  }

  @media screen and (max-width: 749px) {
    /* Media gallery has a peeking slide on the right side always, and on the left side when the current slide is the last one */
    .media-gallery--hint
      :is(
        slideshow-slide:has(+ slideshow-slide[aria-hidden='false']:last-of-type),
        slideshow-slide[aria-hidden='false'] + slideshow-slide
      ) {
      content-visibility: auto;

      slideshow-component[actioned] & {
        content-visibility: visible;
      }
    }
  }

  @media screen and (max-width: 749px) {
    .media-gallery--hint {
      --slideshow-gap: var(--gap-2xs);

      :not(.dialog-zoomed-gallery) > .product-media-container:not(:only-child) {
        width: 90%;

        .product-media img {
          object-fit: cover;
        }
      }
    }
  }

  /* Mobile thumbnails styling */
  @media screen and (max-width: 749px) {
    .media-gallery__mobile-controls[thumbnails] {
      --thumbnail-width: 44px;
    }

    .media-gallery__mobile-controls[thumbnails] .slideshow-controls__thumbnail {
      width: var(--thumbnail-width);
      height: auto;
    }
  }

  .dialog-zoomed-gallery .product-media-container--video deferred-media,
  .dialog-zoomed-gallery .product-media-container--external_video deferred-media {
    height: auto;
    aspect-ratio: var(--ratio);
  }

  .dialog-zoomed-gallery .product-media-container--model .product-media__image {
    /* Make the height match the height of the model-viewer */
    height: 100vh;
  }

  @media screen and (min-width: 750px) {
    :root:active-view-transition .product-media__image {
      background-color: transparent;
    }
  }

  /*
   * Product media gallery slideshow context styles
   */
  .product-media-gallery__slideshow--single-media slideshow-container {
    @media screen and (max-width: 749px) {
      grid-area: unset;
    }
  }

  /* Display grid view as a carousel on mobile, grid on desktop */
  media-gallery:is(.media-gallery--grid) slideshow-component {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    /* Media gallery has a peeking slide on the right side always, and on the left side when the current slide is the last one */
    .media-gallery--hint
      :is(
        slideshow-slide:has(+ slideshow-slide[aria-hidden='false']:last-of-type),
        slideshow-slide[aria-hidden='false'] + slideshow-slide
      ) {
      content-visibility: auto;

      slideshow-component[actioned] & {
        content-visibility: visible;
      }
    }
  }

  @media screen and (min-width: 750px) {
    .media-gallery--carousel slideshow-component:has(slideshow-controls[thumbnails]) {
      &:has(slideshow-controls[pagination-position='right']) {
        display: grid;
        grid-template:
          'container controls' auto
          'arrows controls' min-content
          / 1fr auto;
      }

      &:has(slideshow-controls[pagination-position='left']) {
        display: grid;
        grid-template:
          'controls container' auto
          'controls arrows' min-content
          / auto 1fr;
      }

      slideshow-controls[pagination-position='left'] {
        order: -1;
      }
    }
  }

  /* Zorelle: no edge padding on the arrows themselves. They are round buttons now, and
     the edge spacing comes from slideshow-arrows' padding-inline (see the Zorelle gallery
     arrow rules below); padding here stretched the circles. */
  .media-gallery--carousel slideshow-arrows .slideshow-control {
    padding-inline: 0;
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    slideshow-component:has(:not(.mobile\:hidden) :is(.slideshow-controls__dots, .slideshow-controls__counter))
      .shopify-model-viewer-ui__controls-area {
      /* Position the controls just above the counter */
      bottom: calc(var(--minimum-touch-target) + var(--padding-sm));
    }
  }

  @media screen and (min-width: 750px) {
    slideshow-component:has(:not(.desktop\:hidden) :is(.slideshow-controls__dots, .slideshow-controls__counter))
      .shopify-model-viewer-ui__controls-area {
      /* Position the controls just above the counter */
      bottom: calc(var(--minimum-touch-target) + var(--padding-sm));
    }
  }

  slideshow-slide.product-media-container--tallest {
    content-visibility: visible;
  }

  /* Zorelle: 961–1024px (two columns, narrow image) the left thumbnails move below the
     image as a row. Same selector chain as Horizon's left layout above, so it applies. */
  @media screen and (min-width: 961px) and (max-width: 1024px) {
    .media-gallery--carousel
      slideshow-component:has(slideshow-controls[thumbnails]):has(slideshow-controls[pagination-position='left']) {
      grid-template:
        'container' auto
        'arrows' min-content
        'controls' auto
        / minmax(0, 1fr);
      row-gap: 0.75rem;
    }

    .media-gallery--carousel slideshow-controls[thumbnails][pagination-position='left'] {
      order: 0;
      height: auto;
      min-height: 0;

      .slideshow-controls__thumbnails-container {
        position: static;
        overflow: auto hidden;
      }

      .slideshow-controls__thumbnails {
        flex-direction: row;
        justify-content: flex-start;
        margin-inline: 0;
      }
    }
  }

  /* Zorelle: the sticky side thumbnails stop 55px from the top, clear of the header.
     Horizon uses var(--sticky-header-offset, 0), which isn't defined here, so it was 0.
     Leading media-gallery makes this one step more specific than Horizon's rule. */
  @media screen and (min-width: 750px) {
    media-gallery
      slideshow-controls[thumbnails]:is([pagination-position='right'], [pagination-position='left']):not(
        [controls-on-media]
      )
      .slideshow-controls__thumbnails-container {
      top: 55px;
    }
  }

  /* Zorelle: "1 / 3" counter pill at the bottom centre of the image, 960px and below. */
  .media-gallery__counter {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-start: 50%;
    z-index: var(--layer-raised, 2);
    display: none;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--palette-lightest);
    color: var(--palette-darkest);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
    white-space: nowrap;
    pointer-events: none;
    translate: -50% 0;
  }

  [dir='rtl'] .media-gallery__counter {
    translate: 50% 0;
  }

  @media screen and (max-width: 960px) {
    .media-gallery__counter {
      display: block;
    }
  }

  /* Zorelle: smaller gallery arrows at 1024px and below: 30px circle, 16px icon
     (same size as the product card image arrows, card-gallery.liquid). */
  @media screen and (max-width: 1024px) {
    media-gallery slideshow-arrows .slideshow-control.slideshow-control {
      width: 30px;
      height: 30px;
      min-width: 30px;
      min-height: 30px;

      .svg-wrapper,
      svg {
        width: 16px;
        height: 16px;
      }
    }
  }

  /* Zorelle: below 750px the thumbnails under the image are 64px and left-aligned
     (Horizon: clamp(44px, 7vw, 72px), centred with auto margins). */
  @media screen and (max-width: 749px) {
    /* No side padding, so the first thumbnail lines up with the image edge. */
    media-gallery slideshow-controls[thumbnails] .slideshow-controls__thumbnails {
      margin-inline: 0;
      padding-inline: 0;
    }

    media-gallery slideshow-controls[thumbnails] .slideshow-control.slideshow-controls__thumbnail {
      width: 64px;

      /* Focus ring drawn inside, so the scroll container cannot clip it. */
      &:focus-visible {
        outline-offset: -2px;
      }
    }
  }

  /* Zorelle: gallery arrows on a light circle so they read on any photo, inset from the
     image edges. They fade in on hover / keyboard focus. Fade only: Horizon's slide-in
     moved them past the edge, where the image's overflow clipped them.
     Specificity (0,4,2) beats base.css's hover and focus-within slide-in rules (0,3,x). */
  media-gallery slideshow-arrows {
    padding-inline: 1rem;
    mix-blend-mode: normal;
  }

  media-gallery
    slideshow-arrows
    .slideshow-control.slideshow-control.slideshow-control:is(
      .slideshow-control--previous,
      .slideshow-control--next
    ) {
    opacity: 0;
    animation: none;
    transition:
      opacity 0.25s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  media-gallery
    slideshow-component:is(:hover, :focus-within)
    slideshow-arrows
    .slideshow-control.slideshow-control.slideshow-control:is(
      .slideshow-control--previous,
      .slideshow-control--next
    ) {
    opacity: 1;
  }

  /* Touch screens have no hover: keep them visible. */
  @media (hover: none) {
    media-gallery
      slideshow-arrows
      .slideshow-control.slideshow-control.slideshow-control:is(
        .slideshow-control--previous,
        .slideshow-control--next
      ) {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    media-gallery slideshow-arrows .slideshow-control {
      transition: none;
    }
  }

  media-gallery slideshow-arrows .slideshow-control {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border-radius: 50%;
    background: var(--palette-lightest);
    box-shadow: 0 1px 6px rgb(var(--palette-darkest-rgb) / var(--opacity-15, 0.15));
    color: var(--palette-darkest);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;

    &:hover {
      background: var(--palette-darkest);
      color: var(--palette-lightest);
    }
  }

  /* Zorelle: gallery thumbnails. Unselected are faded; hover brightens them with a light
     frame; the selected one is fully clear with a solid dark frame and a small gap
     around the image. Keyboard focus keeps a visible outline. */
  media-gallery .slideshow-control.slideshow-controls__thumbnail {
    padding: 3px;
    border: 1px solid transparent;
    opacity: 0.55;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease;

    &:hover {
      border-color: rgb(var(--palette-darkest-rgb) / var(--opacity-30, 0.3));
      opacity: 1;
    }

    &:is([aria-selected='true']) {
      border-color: var(--palette-darkest);
      outline: none;
      opacity: 1;
    }

    &:focus-visible {
      outline: 2px solid var(--palette-darkest);
      outline-offset: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    media-gallery .slideshow-control.slideshow-controls__thumbnail {
      transition: none;
    }
  }

  /* Zorelle: magnifier button on the gallery image (bottom corner). */
  .media-gallery__zoom-button.media-gallery__zoom-button {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    z-index: var(--layer-raised);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: var(--palette-darkest);
    color: var(--palette-lightest);
    box-shadow: 0 4px 12px rgb(var(--palette-darkest-rgb) / var(--opacity-20));
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--animation-speed) var(--animation-easing);

    &:hover {
      background-color: var(--palette-darkest);
      color: var(--palette-lightest);
      transform: scale(1.06);
    }

    &:focus-visible {
      outline: 2px solid var(--palette-darkest);
      outline-offset: 3px;
    }

    svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    @media screen and (max-width: 1024px) {
      inset-block-end: 0.75rem;
      inset-inline-end: 0.75rem;
      width: 2.25rem;
      height: 2.25rem;

      svg {
        width: 1.125rem;
        height: 1.125rem;
      }
    }
  }

  /* Zorelle image viewer (zoom-dialog.js): dark full-screen dialog, one image at a time. */
  zoom-dialog .zoom-viewer__dialog {
    --zoom-viewer-gutter: clamp(1rem, 3vw, 2rem);
    --zoom-viewer-button-size: 2.75rem;
    --zoom-viewer-arrow-size: var(--zoom-viewer-button-size);
    --zoom-viewer-scale: 2.5;

    width: 100%;
    height: 100dvh;
    max-width: 100%;
    max-height: 100dvh;
    overflow: hidden;
    overscroll-behavior: contain;
    background-color: var(--palette-darkest);
    color: var(--palette-lightest);
    view-transition-name: none;

    &[open] {
      display: grid;
      grid-template:
        'bar' auto
        'stage' minmax(0, 1fr)
        'hint' auto
        / minmax(0, 1fr);
    }

    @media screen and (max-width: 1024px) {
      --zoom-viewer-arrow-size: 30px;
    }
  }

  .zoom-viewer__bar {
    grid-area: bar;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(var(--zoom-viewer-button-size) + var(--zoom-viewer-gutter) * 2);
    padding-inline: var(--zoom-viewer-gutter);
  }

  .zoom-viewer__counter {
    margin: 0;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: rgb(var(--palette-lightest-rgb) / var(--opacity-80));
  }

  zoom-dialog .zoom-viewer__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--zoom-viewer-button-size);
    height: var(--zoom-viewer-button-size);
    padding: 0;
    border: 1px solid rgb(var(--palette-lightest-rgb) / var(--opacity-20));
    border-radius: 50%;
    background-color: rgb(var(--palette-lightest-rgb) / var(--opacity-8));
    color: var(--palette-lightest);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--animation-speed) var(--animation-easing),
      border-color var(--animation-speed) var(--animation-easing);

    &:hover {
      border-color: rgb(var(--palette-lightest-rgb) / var(--opacity-40));
      background-color: rgb(var(--palette-lightest-rgb) / var(--opacity-20));
      color: var(--palette-lightest);
    }

    &:focus-visible {
      outline: 2px solid var(--palette-lightest);
      outline-offset: 2px;
    }

    svg {
      width: 1rem;
      height: 1rem;
    }
  }

  .zoom-viewer__close {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: var(--zoom-viewer-gutter);
    translate: 0 -50%;
  }

  zoom-dialog .zoom-viewer__arrow {
    position: absolute;
    inset-block-start: 50%;
    z-index: var(--layer-raised);
    width: var(--zoom-viewer-arrow-size);
    height: var(--zoom-viewer-arrow-size);
    translate: 0 -50%;

    /* On phones the arrows sit over the image, so they need a dark fill to stay visible. */
    @media screen and (max-width: 749px) {
      border-color: rgb(var(--palette-lightest-rgb) / var(--opacity-30));
      background-color: rgb(var(--palette-darkest-rgb) / var(--opacity-60));
    }
  }

  .zoom-viewer__arrow--previous {
    inset-inline-start: var(--zoom-viewer-gutter);
  }

  .zoom-viewer__arrow--next {
    inset-inline-end: var(--zoom-viewer-gutter);
  }

  [dir='rtl'] .zoom-viewer__arrow svg {
    scale: -1 1;
  }

  .zoom-viewer__track.zoom-viewer__track {
    grid-area: stage;
    display: grid;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding-inline: calc(var(--zoom-viewer-arrow-size) + var(--zoom-viewer-gutter) * 2);
    cursor: default;

    @media screen and (max-width: 749px) {
      padding-inline: 0;
    }
  }

  .zoom-viewer__slide.zoom-viewer__slide {
    grid-area: 1 / 1;
    display: none;
    place-items: center;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    &[data-active] {
      display: grid;
      animation: zoom-viewer-in var(--animation-speed) var(--animation-easing);
    }

    .product-media {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      background-color: transparent;
    }

    /* Video and 3D media keep their own ratio inside the stage. */
    &:not(.product-media-container--image) .product-media {
      height: auto;
      max-height: 100%;
    }
  }

  .zoom-viewer__frame {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: zoom-in;
    touch-action: manipulation;
    user-select: none;

    &[data-zoomed] {
      cursor: zoom-out;
      touch-action: none;
    }

    .product-media__image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background-color: transparent;
      transform-origin: var(--zoom-origin-x, 50%) var(--zoom-origin-y, 50%);
      transition: transform var(--animation-speed-slow) var(--animation-easing);
      -webkit-user-drag: none;
    }

    &[data-zoomed] .product-media__image {
      transform: scale(var(--zoom-viewer-scale));
    }
  }

  /* Two classes to outrank the global :last-child paragraph margin reset. */
  .zoom-viewer__dialog .zoom-viewer__hint {
    grid-area: hint;
    justify-self: center;
    max-width: calc(100% - var(--zoom-viewer-gutter) * 2);
    margin-block: var(--zoom-viewer-gutter);
    margin-inline: 0;
    padding: 0.625rem 1.25rem;
    border-radius: 999px;
    background-color: rgb(var(--palette-lightest-rgb) / var(--opacity-10));
    color: rgb(var(--palette-lightest-rgb) / var(--opacity-80));
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .zoom-viewer__dialog:has(.zoom-viewer__slide[data-active]:not(.product-media-container--image)) .zoom-viewer__hint {
    visibility: hidden;
  }

  .zoom-viewer__hint-text--touch {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    .zoom-viewer__hint-text--pointer {
      display: none;
    }

    .zoom-viewer__hint-text--touch {
      display: inline;
    }
  }

  @keyframes zoom-viewer-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zoom-viewer__slide[data-active] {
      animation: none;
    }

    .zoom-viewer__frame .product-media__image,
    .media-gallery__zoom-button.media-gallery__zoom-button {
      transition: none;
    }
  }
{% endstylesheet %}
