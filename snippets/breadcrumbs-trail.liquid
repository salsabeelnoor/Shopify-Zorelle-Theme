{% doc %}
  The breadcrumb list: Home / collection / current page. On a product page the collection
  is the one the visitor came from (product URL within a collection), otherwise the
  product's first collection. On a collection page it shows Home / collection; elsewhere
  Home / page title. Shared by the Breadcrumbs section and the Breadcrumbs block, which
  each supply the surrounding <nav>.

  @param {string} home_label - Text for the Home link.
  @param {boolean} [show_collection] - Show the product's collection between Home and the product.

  @example
  <nav aria-label="Breadcrumb">{% render 'breadcrumbs-trail', home_label: 'Home', show_collection: true %}</nav>
{% enddoc %}

{%- liquid
  assign crumb_collection = collection
  if template.name == 'product' and crumb_collection == blank and show_collection
    assign crumb_collection = product.collections.first
  endif

  case template.name
    when 'product'
      assign current_title = product.title
    when 'collection'
      assign current_title = collection.title
      assign crumb_collection = blank
    else
      assign current_title = page_title
  endcase
-%}

<ol class="breadcrumbs__list list-unstyled">
  <li class="breadcrumbs__item">
    <a class="breadcrumbs__link" href="{{ routes.root_url }}">{{ home_label | escape }}</a>
  </li>
  {%- if show_collection and crumb_collection != blank -%}
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a>
    </li>
  {%- endif -%}
  {%- if current_title != blank -%}
    <li class="breadcrumbs__item">
      <span class="breadcrumbs__current" aria-current="page">{{ current_title | escape }}</span>
    </li>
  {%- endif -%}
</ol>

{% stylesheet %}
  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0;
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  /* Separator between items. */
  .breadcrumbs__item + .breadcrumbs__item::before {
    content: '/';
    margin-inline: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40, 0.4));
  }

  .breadcrumbs__link {
    color: rgb(var(--color-foreground-rgb));
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;

    &:hover {
      text-decoration: underline;
    }
  }

  .breadcrumbs__current {
    color: var(--color-foreground);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumbs__link {
      transition: none;
    }
  }
{% endstylesheet %}
