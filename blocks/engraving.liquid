{% doc %}
  Engraving picker for personalised products, built on the product's own engraving option
  (for example an option "Engraving" with values 3 Characters, 5 Characters, …, each variant
  priced with the engraving included). Shows one box per value with its extra price, switches
  the product's variant when a box is chosen (so the price, cart and checkout are one line),
  and adds a text field limited to the number of characters in the chosen value's name. The
  text is saved on the cart line as a line item property. The option is hidden from the
  regular variant picker.

  Shown only when the product has an option with the configured name.

  @example
  {% content_for 'block', type: 'engraving', id: 'engraving' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign option_name = s.option_name | strip | default: 'Engraving'
  assign option_handle = option_name | handleize

  # Find the product's engraving option (name matched case-insensitively).
  assign has_engraving = false
  for product_option in product.options_with_values
    assign product_option_handle = product_option.name | handleize
    if product_option_handle == option_handle
      assign engraving_option = product_option
      assign has_engraving = true
      break
    endif
  endfor

  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign field_id = 'Engraving-' | append: block.id
  assign property_name = s.property_name | strip | default: 'Engraving'

  if has_engraving
    # Extra prices are shown relative to the cheapest value for the current size / metal.
    assign base_price = -1
    for engraving_value in engraving_option.values
      if engraving_value.variant
        if base_price < 0 or engraving_value.variant.price < base_price
          assign base_price = engraving_value.variant.price
        endif
      endif
    endfor
    if base_price < 0
      assign base_price = 0
    endif

    assign selected_max = engraving_option.selected_value | split: ' ' | first | plus: 0
    if selected_max < 1
      assign selected_max = s.fallback_max
    endif
  endif
-%}

{%- if has_engraving -%}
  <script
    src="{{ 'engraving-picker.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  {% style %}
    .engraving--{{ block.id }} {
      --engraving-background: {{ settings.color_palette.color2 | default: settings.color_palette.background }};
    }

    /* The engraving boxes replace this option in the regular variant picker. */
    #shopify-section-{{ section.id }} variant-picker .variant-option:has([data-option-name="{{ engraving_option.name | escape }}"]) {
      display: none;
    }
  {% endstyle %}

  <engraving-picker
    class="engraving engraving--{{ block.id }}"
    data-block-id="{{ block.id }}"
    data-option-name="{{ engraving_option.name | escape }}"
    data-hint-template="{{ s.hint_text | escape }}"
    {{ block.shopify_attributes }}
  >
    <div class="engraving__head">
      <svg
        class="engraving__icon"
        aria-hidden="true"
        focusable="false"
        viewBox="0 0 20 20"
        fill="none"
      >
        <path d="M3.5 16.5l.9-3.6L13.6 3.7a1.6 1.6 0 0 1 2.3 0l.4.4a1.6 1.6 0 0 1 0 2.3l-9.2 9.2-3.6.9z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
        <path d="M12.3 5l2.7 2.7" stroke="currentColor" stroke-width="1.2"/>
      </svg>
      <p class="engraving__heading">{{ s.heading | escape }}</p>
    </div>

    <fieldset class="engraving__fieldset">
      <legend class="engraving__legend">
        <span class="engraving__label">{{ s.label | escape }}:</span>
        <span ref="selectedLabel">
          {%- for engraving_value in engraving_option.values -%}
            {%- if engraving_value.selected -%}
              {%- liquid
                assign extra = 0
                if engraving_value.variant
                  assign extra = engraving_value.variant.price | minus: base_price | at_least: 0
                endif
              -%}
              {{ engraving_value | escape }} (+{{ extra | money }})
            {%- endif -%}
          {%- endfor -%}
        </span>
      </legend>

      <div class="engraving__options">
        {%- for engraving_value in engraving_option.values -%}
          {%- liquid
            assign value_max = engraving_value.name | split: ' ' | first | plus: 0
            if value_max < 1
              assign value_max = s.fallback_max
            endif
            assign extra = 0
            if engraving_value.variant
              assign extra = engraving_value.variant.price | minus: base_price | at_least: 0
            endif
          -%}
          <label class="engraving__option">
            <input
              class="engraving__radio"
              type="radio"
              name="engraving-{{ block.id }}"
              value="{{ engraving_value | escape }}"
              data-index="{{ forloop.index0 }}"
              data-max="{{ value_max }}"
              data-label="{{ engraving_value | escape }} (+{{ extra | money | strip_html | escape }})"
              on:change="/select"
              {% if engraving_value.selected %}
                checked
              {% endif %}
              {% unless engraving_value.available %}
                disabled
              {% endunless %}
            >
            <span class="engraving__option-title">{{ engraving_value | escape }}</span>
            <span class="engraving__option-price">+{{ extra | money }}</span>
          </label>
        {%- endfor -%}
      </div>
    </fieldset>

    <p
      class="engraving__hint"
      id="{{ field_id }}-hint"
      ref="hint"
    >
      {{ s.hint_text | replace: '[count]', selected_max | escape }}
    </p>

    <div class="engraving__field">
      <label
        class="visually-hidden"
        for="{{ field_id }}"
      >
        {{- s.label | escape -}}
      </label>
      <input
        ref="text"
        id="{{ field_id }}"
        class="engraving__input"
        type="text"
        name="properties[{{ property_name | escape }}]"
        form="{{ product_form_id }}"
        maxlength="{{ selected_max }}"
        placeholder="{{ s.placeholder | escape }}"
        autocomplete="off"
        aria-describedby="{{ field_id }}-hint"
        on:input="/updateCount"
        {% if s.required %}
          required
          aria-required="true"
        {% endif %}
      >
      <span
        ref="count"
        class="engraving__count"
        aria-hidden="true"
      >
        0/{{ selected_max }}
      </span>
    </div>
  </engraving-picker>
{%- elsif request.design_mode -%}
  <p
    class="engraving__placeholder"
    {{ block.shopify_attributes }}
  >
    The engraving box appears on products with an option named "{{ option_name | escape }}".
  </p>
{%- endif -%}

{% stylesheet %}
  .engraving {
    display: block;
    width: 100%;
    padding: 1.5rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    background-color: var(--engraving-background, var(--color-background));
    color: var(--color-foreground);
  }

  .engraving__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block-end: 1rem;
    margin-block-end: 1.25rem;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .engraving__icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  .engraving__heading {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .engraving__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .engraving__legend {
    padding: 0;
    margin-block-end: 0.75rem;
    font-size: 13px;
  }

  .engraving__label {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .engraving__options {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: 0.5rem;
  }

  .engraving__option {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.5rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    background-color: var(--color-background);
    text-align: center;
    cursor: pointer;
    transition: border-color var(--animation-speed) var(--animation-easing),
      background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);

    &:hover {
      border-color: var(--palette-darkest);
    }

    &:has(.engraving__radio:checked) {
      border-color: var(--palette-darkest);
      box-shadow: inset 0 0 0 1px var(--palette-darkest);
    }

    &:has(.engraving__radio:focus-visible) {
      outline: 2px solid var(--palette-darkest);
      outline-offset: 2px;
    }

    &:has(.engraving__radio:disabled) {
      opacity: 0.45;
      cursor: not-allowed;
    }
  }

  /* The radio stays in the accessibility tree and keyboard order; the box is its visual. */
  .engraving__radio {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }

  .engraving__option-title {
    font-size: 12px;
    line-height: 1.1;
    overflow-wrap: anywhere;
    letter-spacing: 0.4px;
  }

  .engraving__option:has(.engraving__radio:checked) .engraving__option-title {
    font-weight: 600;
  }

  .engraving__option-price {
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .engraving__hint {
    margin: 1.25rem 0 0.5rem;
    font-size: 12px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .engraving__field {
    position: relative;
  }

  .engraving__input {
    width: 100%;
    padding-block: 10px;
    padding-inline: 1rem 4rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: 15px;

    &::placeholder {
      color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    }

    &:focus-visible {
      outline: 2px solid var(--palette-darkest);
      outline-offset: 0;
    }
  }

  .engraving__count {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 1rem;
    translate: 0 -50%;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    pointer-events: none;
  }

  /* Buy it now can skip the required engraving text, so personalised products check out via the cart. */
  .shopify-section:has(.engraving) :is(.accelerated-checkout-block, shopify-accelerated-checkout) {
    display: none;
  }

  .engraving__placeholder {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .engraving {
      padding: 1.25rem 1rem;
    }

    .engraving__options {
      grid-template-columns: repeat(auto-fill, minmax(6.25rem, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .engraving__option {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Engraving",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "option_name",
      "label": "Engraving option name",
      "info": "The product option that holds the engraving sizes, e.g. \"Engraving\" with values \"3 Characters\", \"5 Characters\". The number at the start of each value is the character limit. The box only shows on products with this option.",
      "default": "Engraving"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Personalise"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Option label",
      "default": "Engraving"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint",
      "info": "[count] is replaced with the character limit.",
      "default": "Required · max. [count] characters"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "e.g. Sarah, 14.02 or initials"
    },
    {
      "type": "text",
      "id": "property_name",
      "label": "Name on the order",
      "info": "How the engraving text is labelled in the cart and on the order.",
      "default": "Engraving"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Engraving text is required",
      "default": true
    },
    {
      "type": "range",
      "id": "fallback_max",
      "label": "Character limit when a value has no number",
      "min": 1,
      "max": 40,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Engraving"
    }
  ]
}
{% endschema %}
