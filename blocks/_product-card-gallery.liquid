

{% assign product = closest.product %}

{% capture children %}
  {% unless product == blank %}
    {%- liquid
      # Sale campaign (Theme settings) wins over compare-at prices: its ribbon shows the
      # campaign text, or its percentage.
      capture campaign_percent
        render 'sale-campaign-percent', product: product
      endcapture
      assign campaign_percent = campaign_percent | strip | plus: 0

      # Discount shown on the sale badge: the biggest saving across the product's variants
      # that are on sale, rounded to a whole percent.
      assign discount_percent = 0
      if campaign_percent > 0
        assign discount_percent = campaign_percent
      elsif settings.badge_sale_style == 'percent' and product.compare_at_price > product.price
        for variant in product.variants
          if variant.compare_at_price > variant.price
            assign saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
            if saving > discount_percent
              assign discount_percent = saving
            endif
          endif
        endfor
      endif
    -%}
    {%- liquid
      assign on_sale = false
      if campaign_percent > 0 or product.compare_at_price > product.price
        assign on_sale = true
      endif
    -%}
    {%- if product.available == false or on_sale -%}
      <div
        class="product-badges product-badges--{{ settings.badge_position }}"
      >
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-custom-badge-sold-out{% elsif on_sale %} color-custom-badge-sale{% endif %}
          "
        >
          {%- if product.available == false -%}
            {{ 'content.product_badge_sold_out' | t }}
          {%- elsif campaign_percent > 0 and settings.sale_campaign_badge != blank -%}
            <span aria-hidden="true">{{ settings.sale_campaign_badge | escape }}</span>
            <span class="visually-hidden">{{ 'content.product_badge_discount_label' | t: percent: campaign_percent }}</span>
          {%- elsif discount_percent > 0 -%}
            <span aria-hidden="true">{{ 'content.product_badge_discount' | t: percent: discount_percent }}</span>
            <span class="visually-hidden">{{ 'content.product_badge_discount_label' | t: percent: discount_percent }}</span>
          {%- elsif product.compare_at_price > product.price -%}
            {{ 'content.product_badge_sale' | t }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- comment -%} Zorelle: card CTA (Add to cart / sizes / Personalise) replaces Horizon's quick-add icon. {%- endcomment -%}
    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'product-card-actions',
        product: product,
        section_id: section.id,
        personalize_label: block.settings.personalize_label,
        size_heading: block.settings.size_heading
      %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% # Title for the zoomed out grid view %}
<h3 class="product-grid-view-zoom-out--details">
  {%- if product == blank -%}
    {{- 'content.product_card_placeholder' | t -}}
  {%- else -%}
    {{- product.title -}}
  {%- endif -%}
</h3>

{% render 'product-card-gallery-zoom-details-styles' %}
{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "text",
      "id": "personalize_label",
      "label": "t:settings.label",
      "default": "Personalise"
    },
    {
      "type": "text",
      "id": "size_heading",
      "label": "t:settings.heading",
      "default": "Select size / option"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
