

{% assign block_settings = block.settings %}
{% liquid
  assign custom_color = false
  if block_settings.background_color != blank or block_settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, section_id: block.id
  endif
%}

{%- capture cart_summary_inner_class -%}
  cart-summary__inner
  {% if block_settings.extend_summary == false and custom_color %} color-custom-{{ block.id }} inherit-parent-scheme--mobile{% endif %}
  {% if block_settings.extend_summary == false and block_settings.border_radius > 0 %} has-border-radius{% endif %}
{%- endcapture -%}

{%- comment -%} Zorelle: border settings in a scoped style block, not inline. {%- endcomment -%}
{% style %}
  .cart-summary--{{ block.id }} {
    {% render 'border-override', settings: block_settings %}
  }
{% endstyle %}

{% if block_settings.extend_summary %}
  <div
    class="section-background{% if custom_color %} color-custom-{{ block.id }} inherit-parent-scheme--mobile{% endif %}"
  ></div>
{% endif %}
<div
  class="
    cart-summary cart-summary--{{ block.id }} border-style
    {% if block_settings.extend_summary == true %}
      cart-summary--extend
      {% if custom_color %} color-custom-{{ block.id }} inherit-parent-scheme--mobile{% endif %}
    {% endif %}
    {% if block_settings.border_radius > 0 %} has-border-radius{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div class="{{ cart_summary_inner_class }}">
    {%- comment -%}
      Zorelle: order summary heading and free-shipping progress (same threshold and texts as
      the cart drawer, Theme settings > Cart) above Shopify's totals; payment icons below.
    {%- endcomment -%}
    <h2 class="cart-summary__heading">{{ 'customer_account.order_summary' | t }}</h2>

    {%- if settings.cart_free_shipping_threshold > 0 -%}
      {%- liquid
        assign free_shipping_cents = settings.cart_free_shipping_threshold | times: 100 | round
        assign free_shipping_remaining = free_shipping_cents | minus: cart.total_price
        assign free_shipping_percent = cart.total_price | times: 100 | divided_by: free_shipping_cents | at_most: 100
        if settings.currency_code_enabled_cart_total
          assign free_shipping_amount = free_shipping_remaining | money_with_currency
        else
          assign free_shipping_amount = free_shipping_remaining | money
        endif
        assign free_shipping_amount_html = '<strong>' | append: free_shipping_amount | append: '</strong>'
      -%}
      <div class="cart-summary__shipping{% if free_shipping_remaining <= 0 %} cart-summary__shipping--reached{% endif %}">
        <p class="cart-summary__shipping-text">
          {%- if free_shipping_remaining > 0 -%}
            {{ settings.cart_free_shipping_text | escape | replace: '[amount]', free_shipping_amount_html }}
          {%- else -%}
            {{ settings.cart_free_shipping_success | escape }}
          {%- endif -%}
        </p>
        <progress
          class="cart-summary__shipping-bar"
          value="{{ free_shipping_percent }}"
          max="100"
          aria-hidden="true"
        ></progress>
      </div>
    {%- endif -%}

    {% render 'cart-summary', accelerated_checkout_buttons_layout: 'vertical', section_id: section.id %}

    {%- if settings.cart_drawer_footer_text != blank or shop.enabled_payment_types.size > 0 -%}
      <div class="cart-summary__footer">
        {%- if settings.cart_drawer_footer_text != blank -%}
          <p class="cart-summary__footer-text">{{ settings.cart_drawer_footer_text | escape }}</p>
        {%- endif -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="cart-summary__payment-icons list-unstyled" aria-label="{{ 'blocks.payment_methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'cart-summary__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cart-summary__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-2xl);
    container-type: inline-size;
    padding: 0;
    position: sticky;
    top: 0;
    align-self: start;

    @media screen and (min-width: 750px) {
      padding: var(--padding-5xl);
      grid-row: 1 / -1;
    }
  }

  /* Header-dependent page rules use #header-group as the :has() subject and reach the page with `~`.
     With body as the subject, every [open] or [aria-expanded] change in the header restyles the whole page. */
  #header-group:has(> .header-section > header-component[sticky]) ~ * .cart-summary__inner {
    top: var(--header-height, 0);
  }

  .cart-summary {
    @media screen and (max-width: 1024px) {
      border: none;
    }

    @media screen and (min-width: 1025px) {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: 1 / -1;
    }
  }

  .cart-summary--extend {
    height: 100%;

    @media screen and (min-width: 1025px) {
      border-inline-end: none;
      border-start-end-radius: 0;
      border-end-end-radius: 0;
    }
  }

  /* If extend is on, only include top and bottom borders when the border radius is 0. */
  .cart-summary--extend:not(.has-border-radius) {
    @media screen and (min-width: 1025px) {
      border-top: none;
      border-bottom: none;
    }
  }

  .cart-summary--extend .cart-summary__inner {
    @media screen and (min-width: 1025px) {
      grid-row: 2 / -1;
      padding: var(--padding-md) var(--page-margin) var(--padding-4xl);
      width: var(--sidebar-width);
    }
  }

  /* ------------------------------------------------------------------
     Zorelle order summary: heading, free-shipping bar, roomier totals,
     a tall full-width checkout button and payment icons.
     ------------------------------------------------------------------ */
  .cart-summary__inner > * {
    width: 100%;
  }

  /* Boxed summary (extend off): the blush card wraps only its content and sticks
     below the header while the items scroll. */
  @media screen and (min-width: 750px) {
    .cart-summary:not(.cart-summary--extend) .cart-summary__inner {
      gap: var(--gap-xl);
      padding: 2rem 2.25rem 2.25rem;
    }
  }

  @media screen and (max-width: 749px) {
    .cart-summary:not(.cart-summary--extend) .cart-summary__inner {
      gap: var(--gap-xl);
      padding: 1.5rem 1.25rem;
    }
  }

  .cart-summary__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.625rem);
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .cart-summary__shipping {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.875rem;
  }

  .cart-summary__shipping-text {
    margin: 0;
    line-height: 1.5;
  }

  /* Native <progress>: the track is the element, the fill is its value pseudo-element. */
  .cart-summary__shipping-bar {
    display: block;
    width: 100%;
    height: 4px;
    border: 0;
    border-radius: 100px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
    color: rgb(var(--color-foreground-rgb) / 0.45);
    overflow: hidden;
    appearance: none;
  }

  .cart-summary__shipping-bar::-webkit-progress-bar {
    border-radius: 100px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
  }

  .cart-summary__shipping-bar::-webkit-progress-value {
    border-radius: 100px;
    background-color: rgb(var(--color-foreground-rgb) / 0.45);
    transition: width 0.6s var(--ease-out-quad, ease-out);
  }

  .cart-summary__shipping-bar::-moz-progress-bar {
    border-radius: 100px;
    background-color: rgb(var(--color-foreground-rgb) / 0.45);
  }

  .cart-summary .cart-totals__total {
    font-size: 1.0625rem;
  }

.cart-summary .cart-totals__total-value {
  font-weight: 600;
}

  .cart-summary .cart__checkout-button {
    width: 100%;
    min-height: 3.25rem;
    border-radius: 0;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cart-summary__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
    text-align: center;
  }

  .cart-summary__footer-text {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
  }

  .cart-summary__payment-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .cart-summary__payment-icon {
    display: block;
    width: 2.375rem;
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-summary__shipping-bar::-webkit-progress-value {
      transition: none;
    }
  }

  /* If extend is off, apply the border radius to the inner summary container */
  .cart-summary__inner.has-border-radius {
    border-radius: var(--border-radius);
  }

  /* On mobile, drop the summary's custom palette and inherit from the cart
     section so the summary visually merges with the rest of the cart page. */
  @media screen and (max-width: 749px) {
    :is(.section-background, .cart-summary, .cart-summary__inner).inherit-parent-scheme--mobile {
      --color: inherit;
      --color-rgb: inherit;
      --color-background: inherit;
      --color-background-rgb: inherit;
      --color-foreground: inherit;
      --color-foreground-rgb: inherit;
      --color-foreground-subdued: inherit;
      --color-border: inherit;
      --color-border-rgb: inherit;
      --color-shadow: inherit;
      --color-shadow-rgb: inherit;
      --color-primary-button-text: inherit;
      --color-primary-button-background: inherit;
      --color-primary-button-border: inherit;
      --color-primary-button-hover-text: inherit;
      --color-primary-button-hover-background: inherit;
      --color-primary-button-hover-border: inherit;
      --color-secondary-button-text: inherit;
      --color-secondary-button-background: inherit;
      --color-secondary-button-border: inherit;
      --color-secondary-button-hover-text: inherit;
      --color-secondary-button-hover-background: inherit;
      --color-secondary-button-hover-border: inherit;
      --color-input-text: inherit;
      --color-input-text-rgb: inherit;
      --color-input-background: inherit;
      --opacity-10-25: inherit;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.summary",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "extend_summary",
      "label": "t:settings.extend_summary",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "paragraph",
      "content": "t:content.cart_summary_mobile_colors"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.summary"
    }
  ]
}
{% endschema %}
