{%- doc -%}
  Shows one part of the product description, restyled to the theme (see
  snippets/product-description-parts.liquid): either the intro text + badges (usually
  inside an accordion row titled "Description") or the "Product details" table with a
  heading. Use two of these blocks to place the parts separately.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  assign part = block.settings.part
-%}

{%- capture part_html -%}
  {%- if product != blank -%}
    {%- render 'product-description-parts', description: product.description, part: part -%}
  {%- endif -%}
{%- endcapture -%}

{%- comment -%} Icon accent: the palette's first colour (no inline styles). {%- endcomment -%}
{% style %}
  .product-story--{{ block.id }} {
    --product-story-accent: {{ settings.color_palette.color1 | default: settings.color_palette.foreground }};
  }
{% endstyle %}

{%- if part_html != blank -%}
  <div class="product-story product-story--{{ part }} product-story--{{ block.id }}" {{ block.shopify_attributes }}>
    {%- if part == 'details' and block.settings.heading != blank -%}
      <h2 class="product-story__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="product-story__content rte">{{ part_html }}</div>
  </div>
{%- elsif request.design_mode -%}
  <div class="product-story product-story--empty" {{ block.shopify_attributes }}></div>
{%- endif -%}

{% stylesheet %}
  .product-story {
    min-width: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80, 0.8));
    font-size: 0.875rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .product-story__content > :first-child,
  .product-story__content .product-description-wrapper > :first-child {
    margin-block-start: 0;
  }

  .product-story__content p {
    margin: 0 0 1rem;
  }

  .product-story__content strong {
    color: var(--color-foreground);
    font-weight: 600;
  }

  /* Badges row: the first <div> in the imported description. */
  .product-story__content .product-description-wrapper > div:first-of-type {
    /* Tidy 2 x 2 grid at every width; labels never wrap. */
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.25rem;
    margin-block: 1.25rem;
    padding: 1rem;
    border: 1px solid rgb(var(--palette-darkest-rgb) / var(--opacity-10, 0.1));
    background: rgb(var(--palette-darkest-rgb) / var(--opacity-5, 0.05));
  }

  .product-story__content .product-description-wrapper > div:first-of-type > div {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-foreground);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
  }

  .product-story__content .product-description-wrapper > div:first-of-type svg {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    stroke: var(--product-story-accent);
  }

  /* Optional note (e.g. "Bespoke Crafting"). */
  .product-story__content .product-description-wrapper > div:nth-of-type(2) {
    padding-inline-start: 0.875rem;
    border-inline-start: 2px solid var(--product-story-accent);
    font-size: 0.8125rem;
  }

  /* Product details table. Inside an accordion row (after the text and badges) it gets
     its own breathing room. "~" not "+": each block outputs its own <style> tag, which
     sits between the two blocks. */
  .details-content .product-story ~ .product-story--details {
    margin-block-start: 2rem;
  }

  .product-story__heading {
    margin: 0 0 0.75rem;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-story--details table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .product-story--details tr {
    border-block-end: 1px solid rgb(var(--palette-darkest-rgb) / var(--opacity-10, 0.1));
  }

  .product-story--details td {
    padding: 0.75rem 0;
    border: 0;
    vertical-align: top;
    text-align: start;
  }

  .product-story--details td:first-child {
    width: 38%;
    padding-inline-end: 1rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60, 0.6));
  }

  .product-story--details td:last-child {
    color: var(--color-foreground);
    font-weight: 500;
  }

  .product-story--details a {
    margin-inline-start: 0.5rem;
    color: var(--product-story-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .product-story--empty {
    min-height: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Description part",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "part",
      "label": "t:settings.show",
      "options": [
        {
          "value": "summary",
          "label": "Text and badges"
        },
        {
          "value": "details",
          "label": "Product details table"
        }
      ],
      "default": "summary"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Product details",
      "visible_if": "{{ block.settings.part == 'details' }}"
    }
  ],
  "presets": [
    {
      "name": "Description part",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
