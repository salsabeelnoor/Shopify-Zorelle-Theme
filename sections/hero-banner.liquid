{% comment %}
  Section contract.
  Full-bleed hero banner with an image or Shopify-hosted background video,
  a heading, a short text, and up to two buttons pinned to the bottom.
  Buttons use the shared .button / .button-secondary styles (assets/buttons.css).
  @example
  <!-- Add "Hero banner" to the top of the home page; choose Image or Video under Media. -->
{% endcomment %}

{% liquid
  assign media_type = section.settings.media_type
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign video = section.settings.video

  assign is_above_fold = false
  if section.index <= 2
    assign is_above_fold = true
  endif

  assign show_video = false
  if media_type == 'video' and video != blank
    assign show_video = true
  endif

  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} .hero-banner {
    --hero-text-color: {{ section.settings.text_color }};
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{% endstyle %}

{%- if show_video -%}
  <script
    src="{{ 'hero-banner.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}

<div class="hero-banner hero-banner--{{ section.settings.height }} hero-banner--align-{{ section.settings.content_alignment }}">
  <div class="hero-banner__media">
    {%- if show_video -%}
      <hero-banner-video class="hero-banner__video">
        {{
          video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            preload: 'metadata',
            class: 'hero-banner__media-item'
        }}
        <button
          type="button"
          class="button-unstyled hero-banner__video-toggle"
          data-hero-video-toggle
          data-label-pause="{{ 'accessibility.pause_video' | t | escape }}"
          data-label-play="{{ 'accessibility.play_video' | t | escape }}"
          aria-label="{{ 'accessibility.pause_video' | t | escape }}"
          aria-pressed="false"
        >
          <svg class="hero-banner__icon-pause" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
          </svg>
          <svg class="hero-banner__icon-play" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="M8 5.5v13l10-6.5z" fill="currentColor"/>
          </svg>
        </button>
      </hero-banner-video>
    {%- elsif image != blank -%}
      {%- liquid
        if is_above_fold
          assign loading = 'eager'
        else
          assign loading = 'lazy'
        endif
        if section.index == 1
          assign fetch_priority = 'high'
        else
          assign fetch_priority = 'auto'
        endif
      -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1100 }} 1100w, {{ image_mobile | image_url: width: 1500 }} 1500w"
          sizes="100vw"
          width="{{ image_mobile.width }}"
          height="{{ image_mobile.height }}"
        >
        {{
          image
          | image_url: width: 3840
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2400, 3000, 3840',
            sizes: '100vw',
            loading: loading,
            fetchpriority: fetch_priority,
            class: 'hero-banner__media-item',
            alt: image.alt
        }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-banner__media-item hero-banner__placeholder' }}
    {%- endif -%}
    <span class="hero-banner__overlay" aria-hidden="true"></span>
  </div>

  {%- liquid
    assign has_button_1 = false
    if section.settings.button_1_label != blank
      assign has_button_1 = true
    endif
    assign has_button_2 = false
    if section.settings.button_2_label != blank
      assign has_button_2 = true
    endif
  -%}

  {%- if section.settings.heading != blank or section.settings.text != blank or has_button_1 or has_button_2 -%}
    <div class="hero-banner__inner container">
    <div class="hero-banner__content">
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="hero-banner__heading h1">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hero-banner__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if has_button_1 or has_button_2 -%}
        <div class="hero-banner__buttons buttons--on-media">
          {%- if has_button_1 -%}
            <a
              class="{% if section.settings.button_1_style == 'secondary' %}button-secondary{% else %}button{% endif %}"
              href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}"
            >
              {{- section.settings.button_1_label | escape -}}
            </a>
          {%- endif -%}
          {%- if has_button_2 -%}
            <a
              class="{% if section.settings.button_2_style == 'secondary' %}button-secondary{% else %}button{% endif %}"
              href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}"
            >
              {{- section.settings.button_2_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .hero-banner--full_screen {
    --hero-height: 100svh;
  }
  @media screen and (max-width: 768px) {
    .hero-banner--full_screen {
      --hero-height: 85svh;
    }
  }
  @media screen and (max-width: 640px) {
    .hero-banner--full_screen {
      --hero-height: 75svh;
    }
  }
  .hero-banner {
    --hero-content-gap: 1rem;

    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: var(--hero-height);
    overflow: hidden;
    color: var(--hero-text-color, var(--palette-lightest));
  }



  .hero-banner--large {
    --hero-height: 80svh;
  }

  .hero-banner--medium {
    --hero-height: 60svh;
  }

  .hero-banner__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Shared .container (base.css) keeps the text on the site's content edge.
     The wrapper ignores pointer events so it never covers the video toggle;
     the text and buttons opt back in. */
  .hero-banner__inner {
    position: relative;
    pointer-events: none;
  }

  .hero-banner__content {
    pointer-events: auto;
  }

  .hero-banner__video {
    display: block;
    position: absolute;
    inset: 0;
  }

  .hero-banner__media-item,
  .hero-banner__media picture,
  .hero-banner__media video {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner__placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10, 0.1));
  }

  /* Bottom-weighted overlay keeps the text readable without dimming the whole image. */
  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(var(--palette-darkest-rgb) / var(--hero-overlay-opacity)) 0%,
      rgb(var(--palette-darkest-rgb) / calc(var(--hero-overlay-opacity) * 0.4)) 45%,
      transparent 75%
    );
    pointer-events: none;
  }

  .hero-banner__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--hero-content-gap);
    min-width: 0;
    max-width: 44rem;
    padding-block: 6rem clamp(2.5rem, 6vh, 4.5rem);
  }

  .hero-banner--align-center .hero-banner__content {
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .hero-banner__heading {
    margin: 0;
    color: inherit;
    overflow-wrap: anywhere;
  }

  .hero-banner__text {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    line-height: 1.5;
    color: inherit;
  }

  .hero-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }

  .hero-banner--align-center .hero-banner__buttons {
    justify-content: center;
  }

  .hero-banner__video-toggle {
    position: absolute;
    inset-block-end: clamp(1.25rem, 4vh, 2rem);
    inset-inline-end: var(--page-margin, 1rem);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--hero-text-color, var(--palette-lightest));
    border: 1px solid currentcolor;
    background: rgb(var(--palette-darkest-rgb) / 0.25);
    cursor: pointer;
    transition: background-color 0.2s ease;

    &:hover,
    &:focus-visible {
      background: rgb(var(--palette-darkest-rgb) / 0.5);
    }

    svg {
      width: 1.125rem;
      height: 1.125rem;
    }
  }

  .hero-banner__icon-play,
  hero-banner-video[paused] .hero-banner__icon-pause {
    display: none;
  }

  hero-banner-video[paused] .hero-banner__icon-play {
    display: block;
  }

  @media screen and (max-width: 640px) {
    .hero-banner__content {
      padding-block-end: 2.5rem;
      gap: 10px;
    }

    .hero-banner__buttons {
      width: 100%;
    }

    .hero-banner__buttons > * {
      flex: 1 1 10rem;
    }
  }

  /* Stack the buttons full width on small screens. */
  @media screen and (max-width: 460px) {
    .hero-banner__buttons {
      flex-direction: column;
    }

    .hero-banner__buttons > * {
      flex: 0 0 auto;
      width: 100%;
    }
  }

  @media screen and (max-width: 749px) {

    /* Keep the toggle clear of the stacked buttons. */
    .hero-banner__video-toggle {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero",
  "class": "hero-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.media_type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.mobile_media",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Everyday luxury"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "Beautiful pieces to pass down for generations"
    },
    {
      "type": "header",
      "content": "t:content.buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "t:settings.label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "t:settings.link"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "t:settings.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:options.primary"
        },
        {
          "value": "secondary",
          "label": "t:options.secondary"
        }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "t:settings.label",
      "default": "Shop sale"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "t:settings.link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "t:settings.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:options.primary"
        },
        {
          "value": "secondary",
          "label": "t:options.secondary"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "full_screen",
          "label": "t:options.full_screen"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        }
      ],
      "default": "full_screen"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:settings.content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "t:names.hero"
    }
  ]
}
{% endschema %}
