{% comment %}
  Section contract.
  Breadcrumb trail: Home / collection / current page, inside the site container.
  On a product page the collection is the one the visitor came from (product URL within
  a collection), otherwise the product's first collection. On a collection page it shows
  Home / collection; elsewhere Home / page title.
  @example
  <!-- Add "Breadcrumbs" above the product information section on the product template. -->
{% endcomment %}

{%- assign s = section.settings -%}

{% style %}
  #shopify-section-{{ section.id }} .breadcrumbs {
    --breadcrumbs-padding-top: {{ s.padding_top }}px;
    --breadcrumbs-padding-bottom: {{ s.padding_bottom }}px;
  }
{% endstyle %}

<nav class="breadcrumbs container" aria-label="{{ s.nav_label | escape }}">
  {%- render 'breadcrumbs-trail', home_label: s.home_label, show_collection: s.show_collection -%}
</nav>

{% stylesheet %}
  .breadcrumbs {
    padding-block: var(--breadcrumbs-padding-top) var(--breadcrumbs-padding-bottom);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Breadcrumbs",
  "tag": "section",
  "class": "section-breadcrumbs",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "home_label",
      "label": "Home link text",
      "default": "Home"
    },
    {
      "type": "checkbox",
      "id": "show_collection",
      "label": "Show collection",
      "default": true
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Screen reader label",
      "default": "Breadcrumb"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Breadcrumbs"
    }
  ]
}
{% endschema %}
