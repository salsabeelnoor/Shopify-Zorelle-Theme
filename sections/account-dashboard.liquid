{% comment %}
  Section contract.
  Custom "My account" page for signed-in customers (new customer accounts), inside the
  theme's header and footer. A welcome band (initials, name, email, sign out) sits above
  tabs: Overview (stats, shortcuts, latest order), Orders (order cards with a details
  dialog and Buy again) and Addresses (add, edit and delete in dialogs, using Shopify's
  customer_address form). Tabs switch with account-tabs.js and follow the URL hash
  (#orders, #addresses …); without JavaScript all panels show. Profile editing is not
  offered: themes cannot save name or email changes. Signed-out visitors see a sign-in card.
  @example
  <!-- Create a page "My account" (handle: my-account) using the page.account template. -->
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

{% style %}
  #shopify-section-{{ section.id }} .account {
    --account-padding-top: {{ s.padding_top }}px;
    --account-padding-bottom: {{ s.padding_bottom }}px;
    --account-tint: {{ settings.color_palette.color2 | default: settings.color_palette.background }};
    --account-accent: {{ settings.color_palette.color1 | default: settings.color_palette.foreground }};
  }
{% endstyle %}

{%- if customer -%}
  {%- liquid
    if customer.first_name == blank
      assign initials = customer.email | slice: 0
    else
      assign initials = customer.first_name | slice: 0
      if customer.last_name != blank
        assign last_initial = customer.last_name | slice: 0
        assign initials = initials | append: last_initial
      endif
    endif

    # Totals come from the order list itself: Shopify's customer statistics (total_spent,
    # last_order) leave out test orders, so they can disagree with the Orders tab.
    assign spent_total = 0
    for order in customer.orders
      unless order.cancelled
        assign spent_total = spent_total | plus: order.total_price
      endunless
    endfor
    assign latest_order = customer.orders | first
  -%}

  <script src="{{ 'account-tabs.js' | asset_url }}" type="module" fetchpriority="low"></script>

  <account-tabs
    class="account container"
    data-toast-added="{{ 'customer_account.toast_added' | t | escape }}"
    data-toast-updated="{{ 'customer_account.toast_updated' | t | escape }}"
    data-toast-deleted="{{ 'customer_account.toast_deleted' | t | escape }}"
  >
    <div class="account-toast" role="status" aria-live="polite" data-account-toast hidden>
      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18">
        <path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span data-account-toast-text></span>
    </div>
    {%- comment -%} Welcome band {%- endcomment -%}
    <header class="account-hero">
      <span class="account-hero__avatar" aria-hidden="true">{{ initials | upcase }}</span>
      <div class="account-hero__text">
        <p class="account-eyebrow">{{ 'customer_account.welcome' | t }}</p>
        <h1 class="account-hero__name">
          {%- if customer.first_name != blank -%}
            {{ customer.name | escape }}
          {%- else -%}
            {{ customer.email | escape }}
          {%- endif -%}
        </h1>
        <p class="account-hero__email">{{ customer.email | escape }}</p>
      </div>
      <div class="account-hero__side">
        <a class="account-link account-hero__signout" href="{{ routes.account_logout_url }}">
          {{- 'customer_account.sign_out' | t -}}
        </a>
      </div>
    </header>

    {%- comment -%} Tabs {%- endcomment -%}
    <nav class="account-tabs" aria-label="{{ 'customer_account.nav_label' | t }}">
      <div class="account-tabs__list" role="tablist">
        <a class="account-tabs__tab" role="tab" href="#overview" id="AccountTab-overview" aria-controls="overview" aria-selected="true">
          {{- 'customer_account.overview' | t -}}
        </a>
        <a class="account-tabs__tab" role="tab" href="#orders" id="AccountTab-orders" aria-controls="orders" aria-selected="false">
          {{- 'customer_account.orders' | t -}}
          <span class="account-tabs__count">{{ customer.orders.size }}</span>
        </a>
        <a class="account-tabs__tab" role="tab" href="#addresses" id="AccountTab-addresses" aria-controls="addresses" aria-selected="false">
          {{- 'customer_account.addresses' | t -}}
          <span class="account-tabs__count">{{ customer.addresses.size }}</span>
        </a>
      </div>
    </nav>

    {%- comment -%} Overview {%- endcomment -%}
    <section class="account-panel" id="overview" role="tabpanel" aria-labelledby="AccountTab-overview" tabindex="-1">
      <h2 class="visually-hidden">{{ 'customer_account.overview' | t }}</h2>
      <ul class="account-stats list-unstyled">
        <li class="account-stat">
          <span class="account-eyebrow">{{ 'customer_account.stat_orders' | t }}</span>
          <strong class="account-stat__value">{{ customer.orders.size }}</strong>
        </li>
        <li class="account-stat">
          <span class="account-eyebrow">{{ 'customer_account.stat_spent' | t }}</span>
          <strong class="account-stat__value">{{ spent_total | money }}</strong>
        </li>
      </ul>

      <ul class="account-shortcuts list-unstyled">
        <li>
          <a class="account-shortcut" href="{{ s.shop_url | default: routes.all_products_collection_url }}">
            {%- render 'trust-badge-icon', icon: 'gem', class: 'account-shortcut__icon' -%}
            <span class="account-shortcut__title">{{ 'customer_account.quick_shop' | t }}</span>
            <span class="account-muted">{{ 'customer_account.quick_shop_text' | t }}</span>
          </a>
        </li>
        <li>
          <a
            class="account-shortcut"
            {% if latest_order %}
              href="#{{ 'AccountOrderLatest-' | append: section.id }}"
              data-order-open="AccountOrderLatest-{{ section.id }}"
            {% else %}
              href="#orders"
              data-account-tab="orders"
            {% endif %}
          >
            {%- render 'trust-badge-icon', icon: 'truck', class: 'account-shortcut__icon' -%}
            <span class="account-shortcut__title">{{ 'customer_account.quick_track' | t }}</span>
            <span class="account-muted">{{ 'customer_account.quick_track_text' | t }}</span>
          </a>
        </li>
        <li>
          <a class="account-shortcut" href="{{ s.contact_url | default: '/pages/contact' }}">
            {%- render 'trust-badge-icon', icon: 'chat', class: 'account-shortcut__icon' -%}
            <span class="account-shortcut__title">{{ 'customer_account.quick_contact' | t }}</span>
            <span class="account-muted">{{ 'customer_account.quick_contact_text' | t }}</span>
          </a>
        </li>
      </ul>

      {%- if latest_order -%}
        <div class="account-block">
          <div class="account-block__head">
            <h3 class="account-block__title">{{ 'customer_account.latest_order' | t }}</h3>
            <a class="account-link" href="#orders" data-account-tab="orders">{{ 'customer_account.view_all' | t }}</a>
          </div>
          {%- assign latest_dialog_id = 'AccountOrderLatest-' | append: section.id -%}
          <div class="account-orders account-orders--latest">
            {% render 'account-order-card', order: latest_order, dialog_id: latest_dialog_id %}
          </div>
          {% render 'account-order-dialog', order: latest_order, dialog_id: latest_dialog_id %}
        </div>
      {%- endif -%}
    </section>

    {%- comment -%} Orders {%- endcomment -%}
    <section class="account-panel" id="orders" role="tabpanel" aria-labelledby="AccountTab-orders" tabindex="-1">
      <div class="account-panel__head">
        <h2 class="account-panel__title">{{ 'customer_account.orders' | t }}</h2>
      </div>
      {%- paginate customer.orders by 8 -%}
        {%- if customer.orders.size == 0 -%}
          <div class="account-empty">
            <p>{{ 'customer_account.no_orders' | t }}</p>
            <a class="account-cta" href="{{ routes.all_products_collection_url }}">{{ 'customer_account.shop_now' | t }}</a>
          </div>
        {%- else -%}
          <div class="account-orders">
            {%- for order in customer.orders -%}
              {%- assign dialog_id = 'AccountOrder-' | append: section.id | append: '-' | append: order.id -%}
              {% render 'account-order-card', order: order, dialog_id: dialog_id %}
              {% render 'account-order-dialog', order: order, dialog_id: dialog_id %}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="account-pagination" aria-label="{{ 'content.pagination.nav_label' | t }}">
              {%- if paginate.previous -%}
                <a class="account-link" href="{{ paginate.previous.url }}#orders">{{ 'content.pagination.previous' | t }}</a>
              {%- endif -%}
              <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
              {%- if paginate.next -%}
                <a class="account-link" href="{{ paginate.next.url }}#orders">{{ 'content.pagination.next' | t }}</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endif -%}
      {%- endpaginate -%}
    </section>

    {%- comment -%} Addresses {%- endcomment -%}
    <section class="account-panel" id="addresses" role="tabpanel" aria-labelledby="AccountTab-addresses" tabindex="-1">
      <div class="account-panel__head">
        <h2 class="account-panel__title">{{ 'customer_account.addresses' | t }}</h2>
        {%- assign new_address_dialog = 'AccountAddressNew-' | append: section.id -%}
        <button
          type="button"
          class="account-cta"
          data-order-open="{{ new_address_dialog }}"
          aria-haspopup="dialog"
        >
          {{- 'customer_account.add_address' | t -}}
        </button>
      </div>
      {% render 'account-address-dialog', address: customer.new_address, dialog_id: new_address_dialog, is_new: true %}
      {%- if customer.addresses.size == 0 -%}
        <div class="account-empty">
          <p>{{ 'customer_account.no_addresses' | t }}</p>
        </div>
      {%- else -%}
        <ul class="account-addresses list-unstyled">
          {%- for address in customer.addresses -%}
            <li class="account-box account-address{% if address.id == customer.default_address.id %} account-address--default{% endif %}">
              <div class="account-address__head">
                <p class="account-address__name">{{ address.name | escape }}</p>
                {%- if address.id == customer.default_address.id -%}
                  <span class="account-pill account-pill--soft">{{ 'customer_account.default' | t }}</span>
                {%- endif -%}
              </div>
              <address class="account-address-text">{{ address | format_address }}</address>
              {%- assign address_dialog = 'AccountAddress-' | append: section.id | append: '-' | append: address.id -%}
              <div class="account-address__actions">
                <button
                  type="button"
                  class="account-cta account-cta--outline"
                  data-order-open="{{ address_dialog }}"
                  aria-haspopup="dialog"
                >
                  {{- 'customer_account.edit' | t -}}
                </button>
                <form
                  method="post"
                  action="{{ routes.account_addresses_url }}/{{ address.id }}"
                  data-confirm="{{ 'customer_account.delete_confirm' | t | escape }}"
                >
                  <input type="hidden" name="_method" value="delete">
                  <button type="submit" class="account-cta account-cta--outline">{{ 'customer_account.delete' | t }}</button>
                </form>
              </div>
              {% render 'account-address-dialog', address: address, dialog_id: address_dialog %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </section>
  </account-tabs>
{%- else -%}
  <div class="account container">
    <div class="account-signed-out">
      <h1 class="account-panel__title">{{ 'customer_account.signed_out_heading' | t }}</h1>
      <p class="account-muted">{{ 'customer_account.signed_out_text' | t }}</p>
      <a class="account-cta" href="{{ routes.account_login_url }}">{{ 'customer_account.sign_in' | t }}</a>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .account {
    --account-border: rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
    --account-gap: clamp(1rem, 0.8rem + 1vw, 1.5rem);

    display: flex;
    flex-direction: column;
    gap: var(--account-gap);
    padding-block: var(--account-padding-top) var(--account-padding-bottom);
    color: var(--color-foreground);
  }

  /* Shared bits */
  .account-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--account-accent);
  }

  .account-muted {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Text links (Sign out, View all, Track package): the underline is drawn as a line
     under the text so it can animate; on hover it sweeps out to the right and back in
     from the left while the text takes the accent colour. */
  .account-link {
    display: inline-block;
    padding-block-end: 0.3em;
    color: var(--color-foreground);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    transition: color 0.3s ease;
  }

  .account-link:hover,
  .account-link:focus-visible {
    color: var(--account-accent);
    animation: account-link-sweep 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  @keyframes account-link-sweep {
    0% {
      background-position: 100% 100%;
      background-size: 100% 1px;
    }

    50% {
      background-position: 100% 100%;
      background-size: 0 1px;
    }

    50.1% {
      background-position: 0 100%;
      background-size: 0 1px;
    }

    100% {
      background-position: 0 100%;
      background-size: 100% 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .account-link:hover,
    .account-link:focus-visible {
      animation: none;
    }
  }

  .account-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding-inline: 1.5rem;
    border: 1px solid var(--color-foreground);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .account-cta:hover {
    background-color: var(--account-accent);
    border-color: var(--account-accent);
  }

  .account-cta--outline {
    background-color: transparent;
    color: var(--color-foreground);
  }

  .account-cta--outline:hover {
    background-color: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  .account-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--account-border);
    border-radius: 100px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .account-pill--soft {
    border-color: transparent;
    background-color: var(--account-tint);
  }

  .account-pill--muted {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60, 0.6));
  }

  .account-box {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--account-border);
  }

  .account-address-text {
    font-style: normal;
    font-size: 0.9375rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .account-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 2rem;
    border: 1px dashed var(--account-border);
  }

  .account-empty p {
    margin: 0;
  }

  /* Welcome band */
  .account-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background-color: var(--account-tint);
  }

  .account-hero__avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: clamp(4rem, 3.4rem + 2vw, 5.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    letter-spacing: 0.04em;
  }

  .account-hero__text {
    display: flex;
    flex: 1 1 16rem;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .account-hero__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
    line-height: 1.05;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .account-hero__email {
    margin: 0;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .account-hero__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }

  @media screen and (max-width: 749px) {
    .account-hero__side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
  }

  /* Tabs */
  .account-tabs {
    border-block-end: 1px solid var(--account-border);
  }

  .account-tabs__list {
    display: flex;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .account-tabs__list::-webkit-scrollbar {
    display: none;
  }

  .account-tabs__tab {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    padding-block: 1rem;
    border-block-end: 2px solid transparent;
    margin-block-end: -1px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      border-color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .account-tabs__tab:hover,
  .account-tabs__tab[aria-selected='true'] {
    color: var(--color-foreground);
    border-block-end-color: var(--color-foreground);
  }

  .account-tabs__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: 0.35rem;
    border-radius: 100px;
    background-color: var(--account-tint);
    color: var(--color-foreground);
    font-size: 0.6875rem;
    letter-spacing: 0;
  }

  .account-tabs__tab[aria-selected='true'] .account-tabs__count {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  /* Mobile: all four tabs fit the width (smaller type, spread evenly); very narrow
     screens wrap to a second row instead of hiding tabs off-screen. */
  @media screen and (max-width: 749px) {
    .account-tabs__list {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0 0.75rem;
      overflow-x: visible;
    }

    .account-tabs__tab {
      gap: 0.35rem;
      padding-block: 0.85rem;
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
    }

    .account-tabs__count {
      min-width: 1.25rem;
      height: 1.25rem;
      font-size: 0.625rem;
    }
  }

  /* Panels */
  .account-panel {
    display: flex;
    flex-direction: column;
    gap: var(--account-gap);
    padding-block-start: 0.5rem;
  }

  .account-panel:focus {
    outline: none;
  }

  .account-panel[hidden] {
    display: none;
  }

  .account-panel__head,
  .account-block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .account-panel__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    text-transform: uppercase;
  }

  .account-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .account-block__title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Overview */
  .account-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--account-gap);
    margin: 0;
    padding: 0;
  }

  .account-stat {
    display: flex;
    flex: 1 1 12rem;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--account-border);
  }

  .account-stat__value {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .account-shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--account-gap);
    margin: 0;
    padding: 0;
  }

  .account-shortcuts > li {
    display: flex;
    flex: 1 1 calc(25% - var(--account-gap));
    min-width: min(100%, 11rem);
  }

  .account-shortcut {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.5rem;
    background-color: var(--account-tint);
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .account-shortcut__icon {
    width: 2rem;
    height: 2rem;
    margin-block-end: 0.75rem;
    stroke-width: 1.1;
  }

  .account-shortcut__title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .account-shortcut:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .account-shortcut:hover .account-muted {
    color: inherit;
  }

  /* Order cards */
  /* Orders and addresses grid: 3 columns, 2 up to 1024px, 1 up to 768px. */
  .account-orders,
  .account-addresses {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--account-gap);
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 1024px) {
    .account-orders,
    .account-addresses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 768px) {
    .account-orders,
    .account-addresses {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Latest order on the overview: darker border so it stands out. */
  .account-orders--latest .account-order {
    border-color: var(--color-foreground);
  }

  /* In the grid, the total sits above the buttons and the card fills its row's height. */
  .account-orders .account-order {
    height: 100%;
  }

  .account-orders .account-order__foot {
    flex-direction: column;
    align-items: stretch;
    margin-block-start: auto;
  }

  .account-orders .account-order__actions,
  .account-orders .account-order__reorder {
    flex: 1;
  }

  .account-orders .account-order__actions > *,
  .account-orders .account-order__reorder .account-cta {
    flex: 1 1 0;
  }

  .account-order {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--account-border);
  }

  .account-order__head,
  .account-order__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .account-order__name {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .account-order__date {
    margin: 0.25rem 0 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
    font-size: 0.875rem;
  }

  .account-order__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .account-order__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .account-order__thumb {
    position: relative;
    width: 4.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: var(--account-tint);
  }

  .account-order__thumb img,
  .account-line__media img,
  .account-order__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .account-order__thumb--more {
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }

  .account-order__qty {
    position: absolute;
    inset-block-end: 0.25rem;
    inset-inline-end: 0.25rem;
    padding: 0.1rem 0.35rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .account-order__total {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    font-size: 0.875rem;
  }

  .account-order__total strong {
    font-size: 1.125rem;
  }

  .account-order__actions,
  .account-order__reorder {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .account-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  /* Address cards fill their grid row; Edit/Delete stay at the bottom. */
  .account-address {
    display: flex;
    flex-direction: column;
  }

  .account-address .account-address__actions {
    margin-block-start: auto;
  }

  .account-address .account-address-text {
    margin-block-end: 1.25rem;
  }

  .account-address {
    border-color: var(--color-foreground);
  }

  .account-address__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-end: 0.75rem;
  }

  .account-address__name {
    margin: 0;
    font-weight: 600;
  }

  /* Order details dialog */
  .account-dialog {
    width: min(48rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .account-dialog::backdrop {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-50, 0.5));
  }

  html:has(.account-dialog[open]) {
    overflow: hidden;
  }

  .account-dialog__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
  }

  .account-dialog__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .account-dialog__title {
    margin: 0.35rem 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    text-transform: uppercase;
  }

  .account-dialog__close {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--account-border);
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .account-dialog__close:hover {
    background-color: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  .account-dialog__section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--account-border);
  }

  .account-dialog__heading {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .account-dialog__items,
  .account-dialog__tracking {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .account-line {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--account-border);
  }

  .account-line__media {
    flex-shrink: 0;
    width: 4.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: var(--account-tint);
  }

  .account-line__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .account-line__title {
    margin: 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .account-line__sku {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60, 0.6));
  }

  .account-line__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    text-align: end;
    white-space: nowrap;
  }

  .account-totals {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 1.25rem;
    background-color: var(--account-tint);
  }

  .account-totals > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .account-totals dt,
  .account-totals dd {
    margin: 0;
  }

  .account-totals__total {
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--account-border);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .account-dialog__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .account-dialog__grid > .account-box {
    flex: 1 1 calc(50% - 1rem);
    min-width: min(100%, 14rem);
  }

  .account-box p {
    margin: 0;
  }

  .account-box__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .account-dialog__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  /* Address actions and form */
  .account-address__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1.25rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--account-border);
  }

  .account-address__actions form {
    margin: 0;
  }

  .account-dialog--form {
    width: min(40rem, calc(100% - 2rem));
  }

  .account-form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .account-field {
    display: flex;
    flex: 1 1 calc(50% - 1rem);
    flex-direction: column;
    gap: 0.4rem;
    min-width: min(100%, 12rem);
  }

  .account-field--full {
    flex-basis: 100%;
  }

  .account-field[hidden] {
    display: none;
  }

  .account-field label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .account-field :is(input, select) {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--account-border);
    border-radius: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-size: 1rem;
  }

  .account-field :is(input, select):focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 0;
    border-color: var(--color-foreground);
  }

  .account-check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .account-check input {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--color-foreground);
  }

  .account-form__errors {
    padding: 0.85rem 1rem;
    background-color: var(--account-tint);
    font-size: 0.9375rem;
  }

  .account-form__errors ul {
    margin: 0;
    padding-inline-start: 1.1rem;
  }

  /* Toast after saving or deleting an address */
  .account-toast {
    position: fixed;
    inset-block-end: 1.5rem;
    inset-inline-start: 50%;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: calc(100% - 2rem);
    padding: 0.9rem 1.4rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    box-shadow: 0 10px 30px rgb(var(--color-foreground-rgb) / 0.2);
    transform: translate(-50%, 1rem);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  [dir='rtl'] .account-toast {
    transform: translate(50%, 1rem);
  }

  .account-toast[hidden] {
    display: none;
  }

  .account-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  [dir='rtl'] .account-toast.is-visible {
    transform: translate(50%, 0);
  }

  .account-toast svg {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .account-toast {
      transition: none;
    }
  }

  /* Signed out */
  .account-signed-out {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 32rem;
    margin-inline: auto;
    padding: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    background-color: var(--account-tint);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .account-cta,
    .account-tabs__tab,
    .account-shortcut {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Account dashboard",
  "tag": "section",
  "class": "section-account-dashboard",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the signed-in customer's orders, addresses and details. Button and label text comes from the theme's translations (Online Store → Themes → Edit default theme content)."
    },
    {
      "type": "url",
      "id": "shop_url",
      "label": "Shop shortcut link",
      "info": "Leave empty to link to all products."
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact shortcut link",
      "info": "Leave empty to link to /pages/contact."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Account dashboard"
    }
  ]
}
{% endschema %}
