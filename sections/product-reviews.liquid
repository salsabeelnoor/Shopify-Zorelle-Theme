{% comment %}
  Section contract.
  Product page "Customer reviews": the product's approved reviews from the Zorelle Reviews
  app (product metafields reviews.rating, reviews.rating_count and zorelle_reviews.list of
  `zorelle_review` metaobjects). Shows the average, a star breakdown, review cards with
  photos and "Show more", or an empty state. "Write a review" opens a popup that checks
  /apps/reviews/eligibility (verified buyers only) and posts to /apps/reviews/submit
  (assets/product-reviews.js). New reviews appear once approved in the app.
  @example
  <!-- Add "Product reviews" to the product template below the product information. -->
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign reviews = product.metafields.zorelle_reviews.list.value
  assign review_count = product.metafields.reviews.rating_count.value | default: 0
  assign average = product.metafields.reviews.rating.value.rating | default: 0
  assign initial_count = s.initial_count | default: 6

  assign count_1 = 0
  assign count_2 = 0
  assign count_3 = 0
  assign count_4 = 0
  assign count_5 = 0
  for review in reviews
    assign stars = review.rating.value.rating | round
    case stars
      when 1
        assign count_1 = count_1 | plus: 1
      when 2
        assign count_2 = count_2 | plus: 1
      when 3
        assign count_3 = count_3 | plus: 1
      when 4
        assign count_4 = count_4 | plus: 1
      when 5
        assign count_5 = count_5 | plus: 1
    endcase
  endfor
  assign listed_count = reviews.size | default: 0

  capture sign_in_url
    echo '/customer_authentication/login?return_to='
    echo product.url | append: '#ProductReviews-' | append: section.id | url_encode
  endcapture
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --review-accent: {{ settings.color_palette.color1 | default: '#a56770' }};
  }
{% endstyle %}

{%- capture body -%}
  <product-reviews
    class="product-reviews"
    id="ProductReviews-{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {%- if review_count > 0 -%}
      <div class="product-reviews__summary">
        <div class="product-reviews__average">
          <p class="product-reviews__score">{{ average | round: 1 }}</p>
          <div class="product-reviews__average-meta">
            {% render 'review-stars', rating: average, size: 'large' %}
            <p class="product-reviews__based-on">{{ 'product_reviews.based_on' | t: count: review_count }}</p>
          </div>
        </div>

        {%- if s.show_breakdown and listed_count > 0 -%}
          <ul class="product-reviews__breakdown list-unstyled">
            {%- for i in (1..5) -%}
              {%- liquid
                assign star = 6 | minus: i
                case star
                  when 5
                    assign row_count = count_5
                  when 4
                    assign row_count = count_4
                  when 3
                    assign row_count = count_3
                  when 2
                    assign row_count = count_2
                  else
                    assign row_count = count_1
                endcase
                assign row_label = 'product_reviews.stars_row' | t: count: star
              -%}
              <li class="product-reviews__breakdown-row">
                <span class="product-reviews__breakdown-label">{{ row_label }}</span>
                <progress
                  class="product-reviews__bar"
                  value="{{ row_count }}"
                  max="{{ listed_count }}"
                  aria-label="{{ row_label }}"
                ></progress>
                <span class="product-reviews__breakdown-count">{{ row_count }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="product-reviews__cta">
          <button type="button" class="content-section__button" data-review-open aria-haspopup="dialog">
            {{- 'product_reviews.write_review' | t -}}
          </button>
        </div>
      </div>

      <div class="product-reviews__list product-reviews__list--columns-{{ s.columns }}">
        {%- for review in reviews -%}
          {%- liquid
            assign card_hidden = false
            if forloop.index > initial_count
              assign card_hidden = true
            endif
          -%}
          {% render 'review-card', review: review, hidden: card_hidden %}
        {%- endfor -%}
      </div>

      {%- if listed_count > initial_count -%}
        <div class="product-reviews__more">
          <button type="button" class="content-section__button content-section__button--outline" data-review-more-button>
            {{- 'product_reviews.show_more' | t -}}
          </button>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="product-reviews__empty">
        <p>{{ 'product_reviews.no_reviews' | t }}</p>
        <button type="button" class="content-section__button" data-review-open aria-haspopup="dialog">
          {{- 'product_reviews.write_review' | t -}}
        </button>
      </div>
    {%- endif -%}

    {%- comment -%} Write a review popup. Panels are switched by product-reviews.js. {%- endcomment -%}
    <dialog class="review-dialog" data-review-dialog aria-labelledby="ReviewDialogTitle-{{ section.id }}">
      <div class="review-dialog__inner">
        <header class="review-dialog__header">
          <div>
            <h2 class="review-dialog__title" id="ReviewDialogTitle-{{ section.id }}">{{ 'product_reviews.form_heading' | t }}</h2>
            <p class="review-dialog__intro">{{ 'product_reviews.form_intro' | t }}</p>
          </div>
          <button type="button" class="review-dialog__close" data-review-close aria-label="{{ 'product_reviews.close' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>
          </button>
        </header>

        <div class="review-dialog__panel" data-review-panel="loading">
          <p class="review-dialog__message">{{ 'product_reviews.checking' | t }}</p>
        </div>

        <div class="review-dialog__panel" data-review-panel="signed_out" hidden>
          <h3 class="review-dialog__subtitle">{{ 'product_reviews.signed_out_title' | t }}</h3>
          <p class="review-dialog__message">{{ 'product_reviews.signed_out_text' | t }}</p>
          <a class="content-section__button" href="{{ sign_in_url | strip }}">{{ 'product_reviews.sign_in' | t }}</a>
        </div>

        <div class="review-dialog__panel" data-review-panel="not_purchased" hidden>
          <p class="review-dialog__message">{{ 'product_reviews.not_purchased' | t }}</p>
        </div>

        <div class="review-dialog__panel" data-review-panel="already_reviewed" hidden>
          <p class="review-dialog__message">{{ 'product_reviews.already_reviewed' | t }}</p>
        </div>

        <div class="review-dialog__panel" data-review-panel="success" hidden>
          <h3 class="review-dialog__subtitle">{{ 'product_reviews.success_title' | t }}</h3>
          <p class="review-dialog__message">{{ 'product_reviews.success_text' | t }}</p>
        </div>

        <form class="review-dialog__panel review-form" data-review-panel="form" data-review-form hidden novalidate>
          <input type="hidden" name="product_id" value="{{ product.id }}">

          <fieldset class="review-form__field review-form__rating">
            <legend class="review-form__label">{{ 'product_reviews.your_rating' | t }}</legend>
            <div class="review-form__stars">
              {%- for i in (1..5) -%}
                <input
                  class="review-form__hidden-input"
                  type="radio"
                  name="rating"
                  value="{{ i }}"
                  id="ReviewRating-{{ section.id }}-{{ i }}"
                  required
                >
                <label for="ReviewRating-{{ section.id }}-{{ i }}" class="review-form__star">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55-4.76-4.64 6.58-.96z"/></svg>
                  <span class="visually-hidden">{{ 'product_reviews.stars_row' | t: count: i }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>

          <div class="review-form__field">
            <label class="review-form__label" for="ReviewTitle-{{ section.id }}">{{ 'product_reviews.title_label' | t }}</label>
            <input class="review-form__input" type="text" name="title" id="ReviewTitle-{{ section.id }}" maxlength="120">
          </div>

          <div class="review-form__field">
            <label class="review-form__label" for="ReviewBody-{{ section.id }}">{{ 'product_reviews.body_label' | t }}</label>
            <textarea
              class="review-form__input review-form__textarea"
              name="body"
              id="ReviewBody-{{ section.id }}"
              rows="5"
              minlength="10"
              maxlength="2000"
              required
              aria-describedby="ReviewBodyHint-{{ section.id }}"
            ></textarea>
            <p class="review-form__hint" id="ReviewBodyHint-{{ section.id }}">{{ 'product_reviews.body_hint' | t }}</p>
          </div>

          <div class="review-form__field">
            <span class="review-form__label">{{ 'product_reviews.photos_label' | t }}</span>
            <ul class="review-form__previews list-unstyled" data-review-previews></ul>
            <label class="review-form__add-photos" data-review-add-photos>
              <input
                class="review-form__hidden-input"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                multiple
                data-review-photo-input
              >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>
              <span>{{ 'product_reviews.add_photos' | t }}</span>
            </label>
          </div>

          <p class="review-form__error" role="alert" data-review-error hidden></p>

          <button type="submit" class="content-section__button review-form__submit" data-review-submit>
            {{- 'product_reviews.submit' | t -}}
          </button>
        </form>
      </div>
    </dialog>

    {% render 'review-lightbox' %}

    <template data-review-strings>
      <span data-key="submit">{{ 'product_reviews.submit' | t }}</span>
      <span data-key="submitting">{{ 'product_reviews.submitting' | t }}</span>
      <span data-key="remove_photo">{{ 'product_reviews.remove_photo' | t }}</span>
      <span data-key="invalid_rating">{{ 'product_reviews.error_rating' | t }}</span>
      <span data-key="invalid_body">{{ 'product_reviews.error_body' | t }}</span>
      <span data-key="invalid_title">{{ 'product_reviews.error_title' | t }}</span>
      <span data-key="invalid_photos">{{ 'product_reviews.error_photos' | t }}</span>
      <span data-key="rate_limited">{{ 'product_reviews.error_rate_limited' | t }}</span>
      <span data-key="not_purchased">{{ 'product_reviews.not_purchased' | t }}</span>
      <span data-key="already_reviewed">{{ 'product_reviews.already_reviewed' | t }}</span>
      <span data-key="generic">{{ 'product_reviews.error_generic' | t }}</span>
    </template>
  </product-reviews>
{%- endcapture -%}

<script src="{{ 'product-reviews.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% render 'content-section',
  settings: s,
  section_id: section.id,
  children: body,
  modifier: 'content-section--reviews',
  settings_tint: settings.color_palette.color2,
  settings_accent: settings.color_palette.color1
%}

{% stylesheet %}
  .product-reviews {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    text-align: start;
  }

  /* Summary: average | breakdown | button */
  .product-reviews__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem clamp(2rem, 4vw, 4rem);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background-color: var(--content-section-tint);
  }

  .product-reviews__average {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .product-reviews__score {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    line-height: 1;
  }

  .product-reviews__based-on {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
  }

  .product-reviews__breakdown {
    display: flex;
    flex: 1 1 14rem;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 22rem;
    margin: 0;
    padding: 0;
  }

  .product-reviews__breakdown-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 2rem;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .product-reviews__breakdown-count {
    text-align: end;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
  }

  .product-reviews__bar {
    display: block;
    width: 100%;
    height: 6px;
    border: 0;
    border-radius: 100px;
    background-color: rgb(var(--color-foreground-rgb) / 0.12);
    overflow: hidden;
    appearance: none;
  }

  .product-reviews__bar::-webkit-progress-bar {
    border-radius: 100px;
    background-color: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .product-reviews__bar::-webkit-progress-value {
    border-radius: 100px;
    background-color: var(--review-accent);
  }

  .product-reviews__bar::-moz-progress-bar {
    border-radius: 100px;
    background-color: var(--review-accent);
  }

  .product-reviews__cta {
    margin-inline-start: auto;
  }

  @media screen and (max-width: 749px) {
    .product-reviews__cta {
      width: 100%;
      margin-inline-start: 0;
    }

    .product-reviews__cta .content-section__button {
      width: 100%;
    }
  }

  /* Review cards */
  .product-reviews__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 0.8rem + 1vw, 1.5rem);
  }

  @media screen and (min-width: 750px) {
    .product-reviews__list--columns-2,
    .product-reviews__list--columns-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1100px) {
    .product-reviews__list--columns-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .product-reviews__more {
    display: flex;
    justify-content: center;
  }

  .product-reviews__more[hidden] {
    display: none;
  }

  .product-reviews__empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
    background-color: var(--content-section-tint);
  }

  .product-reviews__empty p {
    margin: 0;
  }

  /* Write a review popup */
  .review-dialog {
    width: min(36rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .review-dialog::backdrop {
    background-color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  html:has(.review-dialog[open]) {
    overflow: hidden;
  }

  .review-dialog__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
  }

  .review-dialog__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .review-dialog__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    text-transform: uppercase;
  }

  .review-dialog__intro,
  .review-dialog__message {
    margin: 0.4rem 0 0;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80, 0.8));
  }

  .review-dialog__subtitle {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  /* After a review is sent only the thank-you message (and the close button) remains. */
  .review-dialog[data-panel='success'] .review-dialog__header > div {
    display: none;
  }

  /* The close button floats in the corner so it doesn't add an empty row above the message. */
  .review-dialog[data-panel='success'] .review-dialog__inner {
    position: relative;
  }

  .review-dialog[data-panel='success'] .review-dialog__header {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
  }

  .review-dialog[data-panel='success'] .review-dialog__panel {
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2.5rem;
    text-align: center;
  }

  .review-dialog__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .review-dialog__panel[hidden] {
    display: none;
  }

  .review-dialog__close {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
    background: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
  }

  .review-dialog__close svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .review-dialog__close:hover {
    border-color: var(--color-foreground);
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  /* Form */
  .review-form {
    align-items: stretch;
    gap: 1.25rem;
  }

  .review-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .review-form__label {
    padding: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .review-form__input {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-30, 0.3));
    border-radius: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-size: 1rem;
  }

  .review-form__textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .review-form__input:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 0;
    border-color: var(--color-foreground);
  }

  .review-form__hint {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
  }

  /* Always hidden (the theme's .visually-hidden reappears on focus, which showed radio dots). */
  .review-form__hidden-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    opacity: 0;
  }

  /* Star picker: stars up to the hovered or chosen one fill with the accent colour. */
  .review-form__stars {
    display: flex;
    gap: 0.35rem;
  }

  .review-form__star {
    display: flex;
    padding: 0.15rem;
    cursor: pointer;
  }

  .review-form__star svg {
    width: 2rem;
    height: 2rem;
    fill: rgb(var(--color-foreground-rgb) / 0.15);
    transition: fill 0.15s ease, transform 0.15s ease;
  }

  .review-form__star:hover svg {
    transform: scale(1.1);
  }

  .review-form__hidden-input:focus-visible + .review-form__star {
    outline: 2px solid var(--color-foreground);
    outline-offset: 1px;
  }

  .review-form__stars:not(:hover):has(input[value='1']:checked) .review-form__star:nth-of-type(-n + 1) svg,
  .review-form__stars:not(:hover):has(input[value='2']:checked) .review-form__star:nth-of-type(-n + 2) svg,
  .review-form__stars:not(:hover):has(input[value='3']:checked) .review-form__star:nth-of-type(-n + 3) svg,
  .review-form__stars:not(:hover):has(input[value='4']:checked) .review-form__star:nth-of-type(-n + 4) svg,
  .review-form__stars:not(:hover):has(input[value='5']:checked) .review-form__star:nth-of-type(-n + 5) svg,
  .review-form__stars:has(.review-form__star:nth-of-type(1):hover) .review-form__star:nth-of-type(-n + 1) svg,
  .review-form__stars:has(.review-form__star:nth-of-type(2):hover) .review-form__star:nth-of-type(-n + 2) svg,
  .review-form__stars:has(.review-form__star:nth-of-type(3):hover) .review-form__star:nth-of-type(-n + 3) svg,
  .review-form__stars:has(.review-form__star:nth-of-type(4):hover) .review-form__star:nth-of-type(-n + 4) svg,
  .review-form__stars:has(.review-form__star:nth-of-type(5):hover) .review-form__star:nth-of-type(-n + 5) svg {
    fill: var(--review-accent);
  }

  /* Photos */
  .review-form__previews {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
  }

  .review-form__previews:empty {
    display: none;
  }

  .review-form__preview {
    position: relative;
    width: 5rem;
    aspect-ratio: 1;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .review-form__preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-form__preview-remove {
    position: absolute;
    inset-block-start: 0.25rem;
    inset-inline-end: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--color-foreground);
    color: var(--color-background);
    cursor: pointer;
  }

  .review-form__preview-remove svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .review-form__add-photos {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 1.1rem;
    border: 1px dashed rgb(var(--color-foreground-rgb) / var(--opacity-50, 0.5));
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .review-form__add-photos svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .review-form__add-photos:hover {
    border-color: var(--color-foreground);
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .review-form__add-photos:focus-within {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .review-form__add-photos[hidden] {
    display: none;
  }

  .review-form__error {
    margin: 0;
    padding: 0.75rem 1rem;
    background-color: var(--content-section-tint);
    border-inline-start: 3px solid var(--review-accent);
    font-size: 0.9375rem;
  }

  .review-form__error[hidden] {
    display: none;
  }

  .review-form__submit {
    width: 100%;
    min-height: 3.125rem;
  }

  .review-form__submit[aria-disabled='true'] {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .review-form__star svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section-product-reviews",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows this product's approved reviews from the Zorelle Reviews app. Approve new reviews in the app."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Customer reviews"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "checkbox",
      "id": "show_breakdown",
      "label": "Show star breakdown",
      "default": true
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Review columns on desktop",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "initial_count",
      "label": "Reviews shown before \"Show more\"",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "color",
      "id": "box_color",
      "label": "Summary tint colour",
      "info": "Leave empty to use palette colour 2."
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "normal", "label": "t:options.normal" },
        { "value": "wide", "label": "Full page width" }
      ],
      "default": "normal"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Product reviews",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
