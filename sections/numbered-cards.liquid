{% comment %}
  Section contract.
  A row of cards, each with an optional number (01, 02 … or your own), a title, text and an
  optional link. 1 to 4 columns on desktop, stacked on phones. Outlined or tinted cards.
  Good for "How to measure", ordering steps, services or values.
  @example
  <!-- Add "Numbered cards" and one Card block per step. -->
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

{%- capture body -%}
  {%- if section.blocks.size > 0 -%}
    <ol class="numbered-cards numbered-cards--columns-{{ s.columns }} numbered-cards--{{ s.card_style }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign number = b.number
          if number == blank and s.show_numbers
            assign number = forloop.index | prepend: '0' | slice: -2, 2
          endif
        -%}
        <li class="numbered-cards__card" {{ block.shopify_attributes }}>
          {%- if s.show_numbers and number != blank -%}
            <p class="numbered-cards__number" aria-hidden="true">{{ number | escape }}</p>
          {%- endif -%}
          {%- if b.title != blank -%}
            <h3 class="numbered-cards__title">{{ b.title | escape }}</h3>
          {%- endif -%}
          {%- if b.text != blank -%}
            <div class="numbered-cards__text content-section__rich">{{ b.text }}</div>
          {%- endif -%}
          {%- if b.link_label != blank and b.link != blank -%}
            <a class="numbered-cards__link" href="{{ b.link }}">{{ b.link_label | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  {%- endif -%}
{%- endcapture -%}

{% render 'content-section',
  settings: s,
  section_id: section.id,
  children: body,
  settings_tint: settings.color_palette.color2,
  settings_accent: settings.color_palette.color1
%}

{% stylesheet %}
  .numbered-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: start;
  }

  @media screen and (min-width: 750px) {
    .numbered-cards--columns-2,
    .numbered-cards--columns-3,
    .numbered-cards--columns-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .numbered-cards--columns-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .numbered-cards--columns-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .numbered-cards__card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .numbered-cards--outline .numbered-cards__card {
    border: 1px solid var(--color-foreground);
  }

  .numbered-cards--filled .numbered-cards__card {
    background-color: var(--content-section-tint);
  }

  .numbered-cards__number {
    margin: 0;
    color: var(--content-section-accent);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 2rem;
    line-height: 1;
  }

  .numbered-cards__title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .numbered-cards__text {
    line-height: 1.6;
  }

  .numbered-cards__text :is(ol, ul) {
    margin: 0;
    padding-inline-start: 1.1rem;
  }

  .numbered-cards__text li + li {
    margin-block-start: 0.4rem;
  }

  .numbered-cards__link {
    align-self: flex-start;
    margin-block-start: auto;
    padding-block-start: 0.5rem;
    color: var(--color-foreground);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .numbered-cards__link:hover {
    color: var(--content-section-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Numbered cards",
  "tag": "section",
  "class": "section-numbered-cards",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "How it works"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "filled", "label": "Tinted" }
      ],
      "default": "outline"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbers",
      "info": "Cards are numbered 01, 02 … unless a card has its own number.",
      "default": true
    },
    {
      "type": "color",
      "id": "box_color",
      "label": "Card tint colour",
      "info": "For tinted cards. Leave empty to use palette colour 2."
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "normal", "label": "t:options.normal" },
        { "value": "wide", "label": "Full page width" }
      ],
      "default": "normal"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number or short label",
          "info": "Optional. Leave empty for automatic numbering."
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.heading",
          "default": "Card title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.text",
          "default": "<p>Describe this step or point.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Numbered cards",
      "category": "t:categories.text",
      "blocks": [
        { "type": "card", "settings": { "title": "First step" } },
        { "type": "card", "settings": { "title": "Second step" } }
      ]
    }
  ]
}
{% endschema %}
