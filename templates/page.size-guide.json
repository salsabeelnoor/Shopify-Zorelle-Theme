{
  "sections": {
    "banner": {
      "type": "content-banner",
      "settings": {
        "eyebrow": "Size guide",
        "heading": "Ring size chart",
        "heading_tag": "h1",
        "intro": "<p>The perfect ring slides over your knuckle with a little resistance and sits comfortably without spinning. Find your size at home in a few minutes.</p>",
        "button_label": "Shop rings",
        "button_link": "shopify://collections/rings",
        "alignment": "center",
        "content_width": "normal",
        "background_color": "{{ settings.color_palette.color2 }}",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },
    "before": {
      "type": "callout-box",
      "blocks": {
        "tip_1": {
          "type": "point",
          "settings": {
            "text": "Measure at the end of the day, when your fingers are at their largest."
          }
        },
        "tip_2": {
          "type": "point",
          "settings": {
            "text": "Avoid measuring when your hands are cold, as fingers shrink slightly."
          }
        },
        "tip_3": {
          "type": "point",
          "settings": {
            "text": "Measure the exact finger you will wear the ring on. Your dominant hand is usually a little larger."
          }
        },
        "tip_4": {
          "type": "point",
          "settings": {
            "text": "Measure two or three times to be sure."
          }
        }
      },
      "block_order": [
        "tip_1",
        "tip_2",
        "tip_3",
        "tip_4"
      ],
      "settings": {
        "box_heading": "Before you measure",
        "box_style": "filled",
        "list_style": "checks",
        "alignment": "left",
        "content_width": "normal",
        "padding-block-start": 48,
        "padding-block-end": 16
      }
    },
    "methods": {
      "type": "numbered-cards",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "Measure a ring you own",
            "text": "<ol><li>Choose a ring that fits the finger you are buying for.</li><li>Place it on a ruler and measure the <strong>inside diameter</strong> from edge to edge, in millimetres.</li><li>Find that number in the <em>Diameter</em> column of the chart below.</li></ol>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "Measure your finger",
            "text": "<ol><li>Wrap a thin strip of paper or string around the base of your finger.</li><li>Mark where the ends meet. It should be snug but still slide over your knuckle.</li><li>Lay it flat, measure the length in millimetres and find it in the <em>Circumference</em> column.</li></ol>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2"
      ],
