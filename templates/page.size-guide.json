    "tips": {
      "type": "checklist",
      "blocks": {
        "tip_a": {
          "type": "item",
          "settings": {
            "title": "Between two sizes?",
            "text": "Choose the larger one, especially if your knuckles are wider than the base of your finger."
          }
        },
        "tip_b": {
          "type": "item",
          "settings": {
            "title": "Wide bands",
            "text": "(6 mm or more) feel tighter. Go up half a size."
          }
        },
        "tip_c": {
          "type": "item",
          "settings": {
            "title": "Stacking rings",
            "text": "sit close together, so a snug fit keeps them from turning."
          }
        },
        "tip_d": {
          "type": "item",
          "settings": {
            "title": "Buying a gift?",
            "text": "Borrow a ring they wear on the same finger and measure it, or ask someone who knows their size."
          }
        }
      },
